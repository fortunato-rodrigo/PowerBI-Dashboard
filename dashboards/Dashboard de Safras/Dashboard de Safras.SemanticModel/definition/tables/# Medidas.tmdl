	measure 'Eventos - Desloc Barra' =
			
			VAR vEventos = [Eventos]
			VAR vTabela = ALL(f_funnel_events)
			VAR vMax = MAXX(
			    vTabela,
			    [Eventos]
			)
			RETURN
			    (vMax - vEventos) * 0.5
		formatString: #,0
		displayFolder: Funnel Events
		lineageTag: 68f13296-ccb6-4080-94d9-29f55763ed08

	measure 'Eventos - Desloc Barra %' =
			
			VAR vEventos = [Eventos]
			VAR vTabela = ALL(f_funnel_events)
			VAR vMax = cALCULATE([Eventos], ALLSELECTED(f_funnel_events), f_funnel_events[event_type] = "PRESIGNUP")
			VAR vPercentual = DIVIDE(vEventos, vMax)
			VAR vTexto = SWITCH(SELECTEDVALUE(f_funnel_events[event_type]), "PRESIGNUP", "TT: ", "% PSU: ")
			RETURN
			    vTexto & FORMAT(vPercentual, "0.0%")
		displayFolder: Funnel Events
		lineageTag: ba5fb127-a282-43bd-b4b9-3b018821cdd0

