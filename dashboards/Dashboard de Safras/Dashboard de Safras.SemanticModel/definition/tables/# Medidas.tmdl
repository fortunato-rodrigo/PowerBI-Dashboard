	measure 'Presignups Compartilhou Dados Bancários' =
			
			CALCULATE(
			    [Presignups],
			    f_funnel_events[has_shared_bank_details] = TRUE()
			)
		displayFolder: Funnel Events
		lineageTag: 854acf34-bda3-4cb9-a42a-4928525f3507

		formatStringDefinition = ```
				VAR vValor = SELECTEDMEASURE()
				VAR vFormat = 
				SWITCH(
				    TRUE(),
				    vValor >= 1000000000, "#,#0,,,.00B;-#,#0,,,.00B",
				    vValor >= 1000000, "#,#0,,.00M;-#,#0,,.00M",
				    vValor >= 1000, "#,#0,.00K;-#,#0,.00K",
				    vValor >= 0, "#,0;#,0",
				    vValor <= -1000000000, "#,#0,,,.00B;#,#0,,,.00B",
				    vValor <= -1000000, "#,#0,,.00M;#,#0,,.00M",
				    vValor <= -1000, "#,#0,.00K;#,#0,.00K",
				    vValor < 0, "#,0.00;#,0.00"
				)
				RETURN 
				"""" & FORMAT(vValor, vFormat) & """"
				```

