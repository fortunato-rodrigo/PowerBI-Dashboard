	measure 'Eventos - Desloc Barra Anterior %' =
			
			VAR vEventos = [Eventos]
			VAR vDesloc = CALCULATE([Eventos], OFFSET(-1, ALL(f_funnel_events[event_type], f_funnel_events[event_type_id]), ORDERBY(f_funnel_events[event_type_id], ASC)))
			VAR vPercentual = DIVIDE(vEventos, vDesloc, BLANK())
			VAR vTexto = "% ANT: "
			RETURN
			    IF(
			        NOT SELECTEDVALUE(f_funnel_events[event_type_id]) = 1,
			        vTexto & FORMAT(vPercentual, "0.0%"),
			        ""
			    )
		displayFolder: Funnel Events
		lineageTag: a5b132d0-c748-4ee4-b9e2-224933e81d56

