table '# Medidas'
	lineageTag: aca805d9-daaf-492c-846e-dec4c3439fc8

	measure Presignups = ```
			
			    CALCULATE(
			        DISTINCTCOUNT(f_funnel_events[id_customer]),
			        f_funnel_events[event_type] = "PRESIGNUP"
			    )
			```
		displayFolder: Funnel Events
		lineageTag: 021380a1-fb50-4c08-91e0-3a06d0189cee

		formatStringDefinition = ```
				VAR vValor = SELECTEDMEASURE()
				VAR vFormat = 
				SWITCH(
				    TRUE(),
				    vValor >= 1000000000, "#,#0,,,.00B;-#,#0,,,.00B",
				    vValor >= 1000000, "#,#0,,.00M;-#,#0,,.00M",
				    vValor >= 1000, "#,#0,.00K;-#,#0,.00K",
				    vValor >= 0, "#,0;#,0",
				    vValor <= -1000000000, "#,#0,,,.00B;#,#0,,,.00B",
				    vValor <= -1000000, "#,#0,,.00M;#,#0,,.00M",
				    vValor <= -1000, "#,#0,.00K;#,#0,.00K",
				    vValor < 0, "#,0.00;#,0.00"
				)
				RETURN 
				"""" & FORMAT(vValor, vFormat) & """"
				```

