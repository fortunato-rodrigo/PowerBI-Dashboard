	partition f_funnel_events = m
		mode: import
		source =
				let
				    Consulta = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation="2.0", MetricViewBiCompatibilityMode=null]){[Name="prod",Kind="Database"]}[Data], "with recipient_name as (#(lf)select#(lf)  id_customer,#(lf)  max(id_recipient) as id_recipient#(lf)from beecambio.beecambio_tbl_remittance_operation#(lf)where id_recipient IS NOT NULL#(lf)group by all#(lf)),#(lf)#(lf)orders as (#(lf)SELECT #(lf)  id_customer,#(lf)  count(id) as orders,#(lf)  count(case when aggregate_order_status = 'Resgatado' then id else null end) as redeemed_orders#(lf)FROM silver.orders#(lf)GROUP BY 1#(lf)),#(lf)#(lf)created_ops as (#(lf)  select#(lf)    id_customer,#(lf)    count(id) as created_ops#(lf)  from beecambio.beecambio_tbl_remittance_operation#(lf)  group by all#(lf)),#(lf)#(lf)bank_name as (#(lf)select#(lf)  ba.id_customer,#(lf)  ba.bank_name,#(lf)  ba.created_at,#(lf)  row_number() over (partition by ba.id_customer order by ba.created_at desc) as rn#(lf)from beecambio.beecambio_tbl_customer_bank_account as ba#(lf)qualify rn = 1#(lf)),#(lf)#(lf)documentos_validos AS (#(lf)  SELECT#(lf)    id_customer,#(lf)    created_at,#(lf)    doc_status,#(lf)    ROW_NUMBER() OVER (PARTITION BY id_customer ORDER BY created_at) AS tentativa_envio#(lf)  FROM beecambio.beecambio_tbl_document#(lf)  WHERE id_doc_type = 2#(lf)    AND deleted = 'false'#(lf)    AND created_at >= '2024-01-01'#(lf)),#(lf)#(lf)primeira_aprovacao AS (#(lf)  SELECT *#(lf)  FROM documentos_validos#(lf)  WHERE doc_status = 3 -- Aprovado#(lf)),#(lf)#(lf)tentativas_doc_aprovado AS (#(lf)  SELECT#(lf)    id_customer,#(lf)    MIN(tentativa_envio) AS tentativa_documento_aprovado#(lf)  FROM primeira_aprovacao#(lf)  GROUP BY id_customer#(lf)),#(lf)#(lf)ops AS (#(lf)  SELECT#(lf)    id_customer,#(lf)    COUNT(id_remittance) as operations#(lf)  FROM gold.fact_operations#(lf)  WHERE is_ops_processed#(lf)    AND is_intercompany = FALSE#(lf)    AND processed_date >= '2024-01-01'#(lf)  GROUP BY id_customer#(lf)),#(lf)#(lf)patrimony as (#(lf)SELECT #(lf)  RF.customer_id,#(lf)  RF.patrimony,#(lf)  ROW_NUMBER() OVER (PARTITION BY RF.customer_id ORDER BY RF.created_at DESC) seq#(lf)FROM beecambio.beecambio_registration_form RF#(lf)WHERE deleted = false#(lf)),#(lf)#(lf)qualification as (#(lf)  SELECT distinct#(lf)    c.id as id_customer,#(lf)    a.id_question,#(lf)    coalesce(o.goal, 'unknown') as primeira_pergunta,#(lf)    CONCAT_WS("" | "", coalesce(o.goal, 'unknown'), o.title) as segunda_pergunta#(lf)  FROM silver.customers c #(lf)  left join prod.beecambio.beecambio_onboarding_qualification_answers a on c.id = a.id_customer #(lf)  left join prod.beecambio.beecambio_onboarding_qualification_form_questions q on q.id = a.id_question#(lf)  left join prod.beecambio.beecambio_onboarding_qualification_form_options o on o.id = a.id_option#(lf)),#(lf)#(lf)origem_psu as #(lf)(#(lf)    SELECT#(lf)      clp.customer_id,#(lf)      clp.provider#(lf)    FROM beecambio.beecambio_tbl_customer_login_provider clp#(lf)    JOIN beecambio.beecambio_tbl_customer c #(lf)      ON c.id = clp.customer_id#(lf)    WHERE clp.deleted_at IS NULL#(lf)      AND clp.linked_at_signup = TRUE#(lf)      AND clp.created_at >= '2026-04-01 00:00:00'#(lf)      AND c.deleted = FALSE#(lf)    QUALIFY ROW_NUMBER() OVER(PARTITION BY clp.customer_id ORDER BY clp.created_at DESC) = 1#(lf)),#(lf)#(lf)final as (#(lf)SELECT#(lf)    fe.* except(fe.event_tstamp, fe.requirement_type, fe.ocr),#(lf)    DATE(fe.event_tstamp) as event_date,#(lf)    DATE_TRUNC('month', fe.event_tstamp) AS event_month,#(lf)    CASE fe.event_type#(lf)        WHEN 'PRESIGNUP' THEN 1#(lf)        WHEN 'SIGNUP' THEN 2#(lf)        WHEN 'CREATED STORY' THEN 3#(lf)        WHEN 'APPROVED STORY' THEN 4#(lf)        WHEN 'ACQUISITION' THEN 5#(lf)        WHEN 'OPERATION' THEN 6#(lf)    END AS event_type_id,#(lf)    dc.channel_psu as canal_lc,#(lf)    LOWER(COALESCE(dc.source_psu, 'unknown')) AS source_lc,#(lf)    LOWER(COALESCE(dc.medium_psu, 'unknown')) AS medium_lc,#(lf)    dc.origin_platform_psu,#(lf)    dc.os_psu as os,#(lf)    dc.os_name_psu as os_name,#(lf)    dc.device_brand_psu as device_brand,#(lf)    dc.device_name_psu as device_name,#(lf)    dc.device_category_psu as device_category,#(lf)    dc.device_browser_psu as device_browser,#(lf)    dc.mkt_campaign_psu as mkt_campaign_lc,#(lf)    dc.cluster_campaign_psu AS cluster_campaign_lc,#(lf)    dc.media_funnel_psu as media_funnel_lc,#(lf)    dc.utm_adgroup_psu as ad_group_lc,#(lf)    dc.first_page_url_psu AS first_page_url,#(lf)    dc.first_page_path_tratado_psu,#(lf)    lc.first_page_cluster_url AS cluster_url,#(lf)    lc.last_page_path_tratado AS last_page_path_tratado,#(lf)    dc.company_type,#(lf)    dc.age,#(lf)    dc.nationality,#(lf)    dc.state,#(lf)    dc.city,#(lf)    CASE#(lf)        WHEN sv.email LIKE '%fxaas%' THEN 'Email fxaas'#(lf)        ELSE 'Default - Sem fxaas'#(lf)    END AS email_fxaas,#(lf)    CASE#(lf)      WHEN dc.signup_completed_tstamp IS NOT NULL THEN TRUE#(lf)      ELSE FALSE#(lf)    END AS full_registration,#(lf)    sv.company_member_association_type,#(lf)    sv.company_shareholders_count,#(lf)    sv.company_shareholders_with_document,#(lf)    dc.session_description AS cnae_session,#(lf)    dc.division_description AS cnae_division,#(lf)    dc.group_description AS cnae_group,#(lf)    dc.class_description AS cnae_class,#(lf)    dc.subclass AS cnae_subclass,#(lf)    DATE(dc.psu_tstamp) AS presignup_date,#(lf)    DATE(dc.signup_completed_tstamp) AS signup_date,#(lf)    DATE(hc.event_tstamp) AS created_history_date,#(lf)    DATE(hi.event_tstamp) AS approved_history_date,#(lf)    DATE(dc.acquisition_tstamp) AS acquisition_date, #(lf)    EXTRACT(YEAR FROM DATE(dc.acquisition_tstamp)) AS acquisition_year,#(lf)    DATE(so.event_tstamp) AS second_operation_date,#(lf)    po.processed_date as operation_date,#(lf)    DATE_TRUNC('month', dc.psu_tstamp) AS presignup_month,#(lf)    DATE_TRUNC('month', dc.signup_completed_tstamp) AS signup_month,#(lf)    DATE_TRUNC('month', hi.event_tstamp) AS approved_history_month,#(lf)    DATE_TRUNC('month', dc.acquisition_tstamp) AS acquisition_month,#(lf)    DATE_TRUNC('month', so.event_tstamp) AS second_operation_month,#(lf)    DATE_TRUNC('month', po.processed_date) AS operation_month,#(lf)    DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(dc.signup_completed_tstamp)) AS diff_days_psu_to_su,#(lf)    DATEDIFF(DAY, DATE(dc.signup_completed_tstamp), DATE(dc.acquisition_tstamp)) AS diff_days_su_to_acq,#(lf)    dc.days_to_conversion as diff_days_psu_to_acq,#(lf)    DATEDIFF(DAY, DATE(dc.acquisition_tstamp), DATE(so.event_tstamp)) AS diff_days_acq_to_sec,#(lf)    DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(hc.event_tstamp)) AS diff_days_psu_to_created_history,#(lf)    DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(hi.event_tstamp)) AS diff_days_psu_to_approved_history,#(lf)    CASE#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 0 THEN '  D0'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 1 THEN '  D1'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 2 THEN '  D2'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 3 THEN '  D3'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 4 THEN '  D4'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 5 THEN '  D5'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 6 THEN '  D6'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 7 THEN '  D7'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 8 AND 10 THEN ' 08-10'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 11 AND 14 THEN ' 11-14'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 15 AND 30 THEN ' 15-30'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 31 AND 60 THEN ' 31-60'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 61 AND 90 THEN ' 61-90'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 91 AND 100 THEN ' 91-100'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 101 AND 110 THEN '101-110'#(lf)      WHEN DATEDIFF(DAY, DATE(dc.psu_tstamp), DATE(po.processed_date)) BETWEEN 111 AND 120 THEN '111-120'#(lf)      ELSE '121+'#(lf)      END AS diff_days_psu_to_acq_category,#(lf)    CASE#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 0 THEN '   Mês 0'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 1 THEN '   Mês 1'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 2 THEN '   Mês 2'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 3 THEN '   Mês 3'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 4 THEN '   Mês 4'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 5 THEN '   Mês 5'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 6 THEN '   Mês 6'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 7 THEN '   Mês 7'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 8 THEN '   Mês 8'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 9 THEN '   Mês 9'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 10 THEN '  Mês 10'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 11 THEN '  Mês 11'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 12 THEN '  Mês 12'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 13 THEN '  Mês 13'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 14 THEN '  Mês 14'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) = 15 THEN '  Mês 15'#(lf)      WHEN DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) > 15 THEN 'Acima 15m'#(lf)      ELSE 'Excluir'#(lf)    END AS diff_months_psu_to_acq_cat,#(lf)    DATEDIFF(MONTH, DATE(dc.psu_tstamp), DATE(po.processed_date)) AS diff_months_psu_to_acq,#(lf)    DATEDIFF(MONTH, DATE(dc.acquisition_tstamp), DATE(so.event_tstamp)) AS diff_months_acq_to_sec,#(lf)    DATEDIFF(MONTH, DATE(dc.acquisition_tstamp), DATE_TRUNC('month', fe.event_tstamp)) AS month_diff_operation,#(lf)    DATEDIFF(MONTH, DATE(fe.event_tstamp), DATE(so.event_tstamp)) AS month_diff_second_operation,#(lf)    DATEDIFF(MONTH, DATE_TRUNC('month', fe.event_tstamp), DATE(dc.acquisition_tstamp)) AS month_diff_presignup,#(lf)    CASE WHEN DATEDIFF(MONTH, DATE_TRUNC('month', dc.signup_completed_tstamp), DATE(dc.acquisition_tstamp)) < 0 THEN 0 #(lf)         ELSE DATEDIFF(MONTH, DATE_TRUNC('month', dc.signup_completed_tstamp), DATE(dc.acquisition_tstamp)) #(lf)    END AS month_diff_signup,#(lf)    CASE WHEN LOWER(COALESCE(dc.source_psu, '')) = 'nubank' THEN 'Nubank' ELSE 'Não Nubank' END AS is_presignup_nubank,#(lf)    po.premium_status as is_premium_user,#(lf)    CASE#(lf)        WHEN fe.event_type = 'APPROVED STORY' AND fh.nature_operation_name = 'Global Account' THEN 'História de Conta Global'#(lf)        WHEN fe.event_type = 'APPROVED STORY' AND fh.nature_operation_name <> 'Global Account' THEN 'Não é História de Conta Global'#(lf)        ELSE 'Não é event_type = APPROVED STORY'#(lf)    END AS history_name,#(lf)    po.is_affiliate,#(lf)    po.in_or_out,#(lf)    po.currency_abbreviation as currency,#(lf)    po.acquisition,#(lf)    po.institution_fin_id as instituicao_fin,#(lf)    po.voucher_code,#(lf)    po.voucher_type,#(lf)    CASE#(lf)        WHEN po.voucher_code IS NOT NULL THEN 'Com Voucher'#(lf)        ELSE 'Sem Voucher'#(lf)    END AS fl_voucher,#(lf)    po.distributor_name as remessadora,#(lf)    po.nature_operation_name as natureza,#(lf)    po.country,#(lf)    po.operation_platform_beecambio as origin_platform_acq,#(lf)    po.gmv,#(lf)    po.segment,#(lf)    po.bu,#(lf)    po.business_type,#(lf)    po.gross_revenue,#(lf)    DATE_TRUNC('month', fe.event_tstamp) = DATE_TRUNC('month', dc.acquisition_tstamp) AS month_psu_equal_month_acq,#(lf)    DATE_TRUNC('month', fe.event_tstamp) = DATE_TRUNC('month', dc.signup_completed_tstamp) AS month_psu_equal_month_su,#(lf)    DATE_TRUNC('month', dc.acquisition_tstamp) = DATE_TRUNC('month', dc.signup_completed_tstamp) AS month_su_equal_month_acq,#(lf)    DATE_TRUNC('month', dc.acquisition_tstamp) = DATE_TRUNC('month', so.event_tstamp) AS month_acq_equal_month_second_operation,#(lf)    dc.has_shared_bank_details,#(lf)    dc.shared_bank_details_platform,#(lf)    dc.shared_bank_details_label,#(lf)    dc.shared_bank_details_tstamp,#(lf)    co.requeriment_actual_status as requirement_status,#(lf)    co.requirement_type,#(lf)    co.institution_financial,#(lf)    co.has_uploaded_identification,#(lf)    co.identification_document_type_name,#(lf)    co.doc_identification_status_name,#(lf)    co.ocr,#(lf)    co.ocr_doc_type,#(lf)    co.ocr_analysis_reference_status,#(lf)    co.ocr_validated,#(lf)    co.ocr_analyzed_document,#(lf)    co.compliance_lock,#(lf)    co.compliance_veredict,#(lf)    co.is_active_requirement,#(lf)    CASE#(lf)      WHEN ops.operations BETWEEN 0 AND 1 THEN ' 01'#(lf)      WHEN ops.operations = 2 THEN ' 02'#(lf)      WHEN ops.operations = 3 THEN ' 03'#(lf)      WHEN ops.operations = 4 THEN ' 04'#(lf)      WHEN ops.operations BETWEEN 5 AND 6 THEN ' 05 a 06'#(lf)      WHEN ops.operations BETWEEN 7 AND 10 THEN ' 07 a 10'#(lf)      WHEN ops.operations BETWEEN 11 AND 20 THEN ' 11 a 20'#(lf)      WHEN ops.operations BETWEEN 21 AND 50 THEN ' 21 a 50'#(lf)      WHEN ops.operations > 50 THEN '+50'#(lf)      ELSE 'Sem operação'#(lf)    END AS operations,#(lf)#(lf)--------------------------------------------------------- PJ:#(lf)#(lf)-- Filtro de Clientes FxaaS#(lf)CASE#(lf)    WHEN sv.email LIKE '%fxaas%' THEN TRUE#(lf)    ELSE FALSE#(lf)END AS pj_fxaas,#(lf)#(lf)CASE#(lf)  WHEN cq.id_qualification_outbound IS NOT NULL THEN 'Outbound'#(lf)  WHEN cq.id_qualification_inbound IS NOT NULL THEN 'Inbound'#(lf)  ELSE 'Sem Qualificação'#(lf)END AS qualification_type,#(lf)#(lf)-- Classificação do fluxo#(lf)CASE#(lf)  WHEN fe.customer_type = 'PF' THEN 'PF Normal'#(lf)  WHEN fe.onboarding_type = 'instant' and cq.id_qualification_outbound is not null then 'PJ Instant Outbound'#(lf)  WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound  is not null then 'PJ Instant Inbound'#(lf)  WHEN fe.onboarding_type = 'express' and cq.id_qualification_outbound is not null then 'PJ Express Outbound'#(lf)  WHEN fe.onboarding_type = 'express' and cq.id_qualification_inbound  is not null then 'PJ Express Inbound'#(lf)  ELSE 'PJ Offline'#(lf)END AS pj_fluxo,#(lf)#(lf)-- Etapa 1 - Presignup (email, CNPJ, ddi, telefone e senha)#(lf)CASE WHEN sv.email IS NOT NULL AND sv.cnpj_cpf_client IS NOT NULL AND O.country_code IS NOT NULL AND O.phone IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen1_psu,#(lf)#(lf)-- Etapa 2 - Qualificação#(lf)CASE WHEN cq.id_customer IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen2_qualification,#(lf)#(lf)-- Etapa 3:#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND dc.has_shared_bank_details THEN TRUE ELSE FALSE END AS pj_screen3_shared_bank_details_instant_inbound, -- Instant Inbound compartilhar dados#(lf)CASE WHEN fe.onboarding_type = 'express' and dc.signup_completed_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen3_signup_completed_express, -- Express - Signup#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_outbound IS NOT NULL AND rn.id_recipient IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen3_recipient_instant_outbound, -- Instant Outbound - Beneficiário#(lf)#(lf)-- Etapa 4#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND od.orders > 0 THEN TRUE ELSE FALSE END AS pj_screen4_orders_instant_inbound, -- Instant Inbound - Recebimento da Ordem#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_outbound IS NOT NULL AND hc.event_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen4_created_story_instant_outbound, -- Instant Outbound - Criar História#(lf)CASE WHEN fe.onboarding_type = 'express' and sv.company_shareholders_with_document > 0 THEN TRUE ELSE FALSE END AS pj_screen4_documents_express, -- Express - Envio do Documento#(lf)#(lf)-- Etapa 5#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND hc.event_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen5_created_story_instant_inbound, -- Instant Inbound Criar História#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_outbound IS NOT NULL AND dc.signup_completed_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen5_signup_completed_instant_outbound, -- Instant Outbound - Signup#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_inbound IS NOT NULL AND dc.has_shared_bank_details THEN TRUE ELSE FALSE END AS pj_screen5_shared_bank_details_express_inbound, -- Express Inbound compartilhar dados#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_outbound IS NOT NULL AND rn.id_recipient IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen5_recipient_express_outbound, -- Instant Outbound - Beneficiário#(lf)#(lf)-- Etapa 6#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND dc.signup_completed_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen6_signup_completed_instant_inbound, -- Instant Inbound - Signup#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_outbound IS NOT NULL AND sv.company_shareholders_with_document > 0 THEN TRUE ELSE FALSE END AS pj_screen6_documents_instant_outbound, -- Instant Outbound - Envio do Documento#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_inbound IS NOT NULL AND od.orders > 0 THEN TRUE ELSE FALSE END AS pj_screen6_orders_express_inbound, -- Express Inbound - Recebimento da Ordem#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_outbound IS NOT NULL AND hc.event_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen6_created_story_express_outbound, -- Express Outbound - Criar História#(lf)#(lf)-- Etapa 7#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND sv.company_shareholders_with_document > 0 THEN TRUE ELSE FALSE END AS pj_screen7_documents_instant_inbound, -- Instant Inbound - Envio do Documento#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_outbound IS NOT NULL AND cr.created_ops > 0 THEN TRUE ELSE FALSE END AS pj_screen7_created_ops_instant_outbound, -- Instant Outbound - Criar Operação ETAPA FINAL#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_inbound IS NOT NULL AND hc.event_tstamp IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen7_created_story_express_inbound, -- Express Inbound - Criar História#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_outbound IS NOT NULL AND cr.created_ops > 0 THEN TRUE ELSE FALSE END AS pj_screen7_created_ops_express_outbound, -- Express Outbound - Criar Operação ETAPA FINAL#(lf)#(lf)-- Etapa 8#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND bk.bank_name IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen8_bank_name_instant_inbound, -- Instant Inbound - Conta PJ#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_inbound IS NOT NULL AND bk.bank_name IS NOT NULL THEN TRUE ELSE FALSE END AS pj_screen8_bank_name_express_inbound, -- Express Inbound - Conta PJ#(lf)#(lf)-- Etapa 9#(lf)CASE WHEN fe.onboarding_type = 'instant' and cq.id_qualification_inbound IS NOT NULL AND od.redeemed_orders > 0 THEN TRUE ELSE FALSE END AS pj_screen9_redeemed_order_instant_inbound, -- Instant Inbound - Conta PJ -- Etapa Final#(lf)CASE WHEN fe.onboarding_type = 'express' and cq.id_qualification_inbound IS NOT NULL AND od.redeemed_orders > 0 THEN TRUE ELSE FALSE END AS pj_screen9_redeemed_order_express_inbound, -- Express Inbound - Conta PJ -- Etapa Final#(lf)#(lf)--------------------------------------------------------- PF:#(lf)#(lf)-- Etapa 1 - Presignup (name, cpf_cnpj, email)#(lf)CASE WHEN sv.customer_name IS NOT NULL AND sv.cnpj_cpf_client IS NOT NULL AND sv.email IS NOT NULL THEN TRUE ELSE FALSE END AS pf_app_screen1_filled,#(lf)-- Etapa 2 - Dados Pessoais#(lf)CASE WHEN sv.customer_name IS NOT NULL AND sv.doc_number IS NOT NULL AND sv.birthday_date IS NOT NULL AND sv.nationality IS NOT NULL AND sv.genre IS NOT NULL AND sv.mother_name IS NOT NULL#(lf)AND O.country_code IS NOT NULL AND sv.mobile_phone IS NOT NULL THEN TRUE ELSE FALSE END AS pf_app_screen4_personal_data_filled,#(lf)-- Etapa 3: Endereço#(lf)CASE WHEN sv.address IS NOT NULL AND A.str_number IS NOT NULL AND A.neighbor IS NOT NULL AND A.city IS NOT NULL AND A.state IS NOT NULL THEN TRUE ELSE FALSE END AS pf_app_screen5_address_filled,#(lf)-- Etapa 4: Renda e residência fiscal#(lf)CASE WHEN dc.monthly_income IS NOT NULL AND RF.patrimony IS NOT NULL AND sv.american_fiscal_resident IS NOT NULL THEN TRUE ELSE FALSE END AS pf_app_screen6_income_tax_residency_filled,#(lf)-- Etapa 5: Documento de identificação#(lf)co.has_uploaded_identification AS pf_app_screens7_to_9_document_filled,#(lf)---------------------------------------------------------#(lf)#(lf)q.primeira_pergunta as qualification_1,#(lf)#(lf)q.segunda_pergunta as qualification_2, #(lf)dc.onb_ops_type as onb_ops_type_pj,#(lf)dc.onb_reason as onb_reason_pj,#(lf)dc.onb_digital_platform_pj,#(lf)dc.onb_amount_pj,#(lf)dc.onb_forecast_pj,#(lf)#(lf)dc.has_affiliate_ops_rec,#(lf)dc.has_affiliate_ops_acq,#(lf)#(lf)coalesce(ps.provider,'no provider') as provider#(lf)#(lf)FROM gold.funnel_event AS fe#(lf)#(tab)LEFT JOIN gold.fact_customers as dc ON fe.id_customer = dc.id_customer#(lf)#(tab)LEFT JOIN silver.customers AS sv ON fe.id_customer = sv.id#(lf)#(tab)LEFT JOIN patrimony AS RF ON fe.id_customer = RF.customer_id AND RF.seq = 1#(lf)  LEFT JOIN recipient_name as rn ON fe.id_customer = rn.id_customer#(lf)  LEFT JOIN orders AS od ON fe.id_customer = od.id_customer#(lf)  LEFT JOIN created_ops AS cr ON fe.id_customer = cr.id_customer#(lf)  LEFT JOIN bank_name AS bk ON fe.id_customer = bk.id_customer#(lf)#(tab)LEFT JOIN beecambio.beecambio_company_qualification AS cq ON fe.id_customer = cq.id_customer#(lf)  LEFT JOIN beecambio.beecambio_tbl_customer AS O ON fe.id_customer = O.id#(lf)#(tab)LEFT JOIN beecambio.beecambio_tbl_customer_address AS A ON O.id = A.id_customer#(lf)#(tab)LEFT JOIN gold.funnel_event AS hc ON fe.id_customer = hc.id_customer AND hc.event_type = 'CREATED STORY' AND hc.event_sequence = 1#(lf)#(tab)LEFT JOIN gold.funnel_event AS hi ON fe.id_customer = hi.id_customer AND hi.event_type = 'APPROVED STORY' AND hi.event_sequence = 1#(lf)#(tab)LEFT JOIN gold.funnel_event AS so ON fe.id_customer = so.id_customer AND so.event_type = 'OPERATION' AND so.event_sequence = 2#(lf)#(tab)LEFT JOIN gold.fact_operations AS po ON fe.event_id = po.id_remittance AND fe.event_type IN ('ACQUISITION', 'OPERATION')#(lf)#(tab)LEFT JOIN bronze.beecambio_history as fh ON fe.event_id = fh.id AND fe.event_type = 'APPROVED STORY'#(lf)#(tab)LEFT JOIN google_analytics.last_click_sessions AS lc ON lc.id_customer = fe.id_customer#(lf)#(tab)LEFT JOIN ops ON fe.id_customer = ops.id_customer AND fe.event_type = 'ACQUISITION'#(lf)#(tab)LEFT JOIN silver.requirement AS co ON fe.id_customer = co.id_customer#(lf)#(tab)#(tab)AND co.institution_financial = 'Topázio'#(lf)#(tab)#(tab)AND co.requeriment_date >= '2024-01-01'#(lf)#(tab)#(tab)AND (#(lf)#(tab)#(tab)  (co.customer_type = 'PF' AND co.requirement_type IN ('Simples', 'Completo'))#(lf)#(tab)#(tab)  OR#(lf)#(tab)#(tab)  (co.customer_type = 'PJ' AND co.requirement_type = 'Completo')#(lf)#(tab)#(tab))#(lf)  LEFT JOIN qualification as q on fe.id_customer = q.id_customer#(lf)  LEFT JOIN origem_psu as ps on fe.id_customer = ps.customer_id#(lf)WHERE DATE(fe.event_tstamp) >= '2024-01-01'#(lf)  AND (#(lf)        (fe.event_sequence = 1 AND fe.event_type IN ('ACQUISITION', 'PRESIGNUP', 'SIGNUP', 'APPROVED STORY', 'CREATED STORY'))#(lf)        OR#(lf)        (fe.event_type = 'OPERATION')#(lf)      )#(lf))#(lf)#(lf)SELECT DISTINCT#(lf)  f.*,#(lf)  case#(lf)    when f.pf_app_screens7_to_9_document_filled = false then 'Não Enviado'#(lf)    when f.pf_app_screens7_to_9_document_filled and t.tentativa_documento_aprovado is null then 'Não Aprovado'#(lf)    when t.tentativa_documento_aprovado = 1 then 'Aprovado na 1ª tentativa'#(lf)    when t.tentativa_documento_aprovado = 2 then 'Aprovado na 2ª tentativa'#(lf)    else 'Mais de +3ª tentativa'#(lf)  end as tentativa_documento_aprovado,  #(lf)#(lf)------------------------------------ PF:#(lf)  CASE#(lf)    WHEN customer_type = 'PJ' THEN 'PJ não se aplica'#(lf)    WHEN pf_app_screens7_to_9_document_filled = TRUE THEN 'Etapa 5 - Envio Documento'#(lf)    WHEN pf_app_screen6_income_tax_residency_filled = TRUE THEN 'Etapa 4 - Renda e Residência'#(lf)    WHEN pf_app_screen5_address_filled = TRUE THEN 'Etapa 3 - Endereço'#(lf)    WHEN pf_app_screen4_personal_data_filled = TRUE THEN 'Etapa 2 - Dados Pessoais'#(lf)    WHEN pf_app_screen1_filled = TRUE THEN 'Etapa 1 - Presignup'#(lf)  END AS pf_app_journey_stage,#(lf)#(lf)------------------------------------ PJ:#(lf)#(lf)CASE#(lf)  WHEN customer_type = 'PF' THEN 'PF não se aplica'#(lf)  WHEN pj_screen9_redeemed_order_instant_inbound THEN 'Etapa 9 - Ordem Resgatada'#(lf)  WHEN pj_screen8_bank_name_instant_inbound THEN 'Etapa 8 - Conta PJ Cadastrada'#(lf)  WHEN pj_screen7_documents_instant_inbound THEN 'Etapa 7 - Enviou Documentos'#(lf)  WHEN pj_screen6_signup_completed_instant_inbound THEN 'Etapa 6 - Finalizou Cadastro'#(lf)  WHEN pj_screen5_created_story_instant_inbound THEN 'Etapa 5 - Criou História'#(lf)  WHEN pj_screen4_orders_instant_inbound THEN 'Etapa 4 - Recebeu Ordem'#(lf)  WHEN pj_screen3_shared_bank_details_instant_inbound THEN 'Etapa 3 - Compartilhou Dados Bancários'#(lf)  WHEN pj_screen2_qualification THEN 'Etapa 2 - Qualificação'#(lf)  WHEN pj_screen1_psu THEN 'Etapa 1 - Presignup'#(lf)  ELSE 'Desconhecido'#(lf)END AS pj_journey_stage_instant_inbound,#(lf)#(lf)CASE#(lf)  WHEN customer_type = 'PF' THEN 'PF não se aplica'#(lf)  WHEN pj_screen7_created_ops_instant_outbound THEN 'Etapa 7 - Criou Operação'#(lf)  WHEN pj_screen6_documents_instant_outbound THEN 'Etapa 6 - Enviou Documentos'#(lf)  WHEN pj_screen5_signup_completed_instant_outbound THEN 'Etapa 5 - Finalizou Cadastro'#(lf)  WHEN pj_screen4_created_story_instant_outbound THEN 'Etapa 4 - Criou História'#(lf)  WHEN pj_screen3_recipient_instant_outbound THEN 'Etapa 3 - Indicou Beneficiário'#(lf)  WHEN pj_screen2_qualification THEN 'Etapa 2 - Qualificação'#(lf)  WHEN pj_screen1_psu THEN 'Etapa 1 - Presignup'#(lf)  ELSE 'Desconhecido'#(lf)END AS pj_journey_stage_instant_outbound,#(lf)#(lf)CASE#(lf)  WHEN customer_type = 'PF' THEN 'PF não se aplica'#(lf)  WHEN pj_screen9_redeemed_order_express_inbound THEN 'Etapa 9 - Ordem Resgatada'#(lf)  WHEN pj_screen8_bank_name_express_inbound THEN 'Etapa 8 - Conta PJ Cadastrada'#(lf)  WHEN pj_screen7_created_story_express_inbound THEN 'Etapa 7 - Criou História'#(lf)  WHEN pj_screen6_orders_express_inbound THEN 'Etapa 6 - Recebeu Ordem'#(lf)  WHEN pj_screen5_shared_bank_details_express_inbound THEN 'Etapa 5 - Compartilhou Dados Bancários'#(lf)  WHEN pj_screen4_documents_express THEN 'Etapa 4 - Enviou Documentos'#(lf)  WHEN pj_screen3_signup_completed_express THEN 'Etapa 3 - Finalizou Cadastro'#(lf)  WHEN pj_screen2_qualification THEN 'Etapa 2 - Qualificação'#(lf)  WHEN pj_screen1_psu THEN 'Etapa 1 - Presignup'#(lf)  ELSE 'Desconhecido'#(lf)END AS pj_journey_stage_express_inbound,#(lf)#(lf)CASE#(lf)  WHEN customer_type = 'PF' THEN 'PF não se aplica'#(lf)  WHEN pj_screen7_created_ops_express_outbound THEN 'Etapa 7 - Criou Operação'#(lf)  WHEN pj_screen6_created_story_express_outbound THEN 'Etapa 6 - Criou História'#(lf)  WHEN pj_screen5_recipient_express_outbound THEN 'Etapa 5 - Indicou Beneficiário'#(lf)  WHEN pj_screen4_documents_express THEN 'Etapa 4 - Enviou Documentos'#(lf)  WHEN pj_screen3_signup_completed_express THEN 'Etapa 3 - Finalizou Cadastro'#(lf)  WHEN pj_screen2_qualification THEN 'Etapa 2 - Qualificação'#(lf)  WHEN pj_screen1_psu THEN 'Etapa 1 - Presignup'#(lf)  ELSE 'Desconhecido'#(lf)END AS pj_journey_stage_express_outbound#(lf)#(lf)FROM final f#(lf)LEFT JOIN tentativas_doc_aprovado t ON f.id_customer = t.id_customer", null, [EnableFolding=true]),
				    #"Colunas Renomeadas" = Table.RenameColumns(Consulta, {
				    {"month_psu_equal_month_acq", "Month PSU = Month ACQ"},
