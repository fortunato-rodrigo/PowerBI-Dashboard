	column WeekStartDate = ```
			
			VAR ThisDate = 'd_calendar'[Date Key]
			VAR StartName = SELECTEDVALUE( NomeSemana[mNomeSemana], 0 )
			VAR StartNum =
			    SWITCH(
			        StartName,
			        "Segunda", 1,
			        "Terça",   2,
			        "Quarta",  3,
			        "Quinta",  4,
			        "Sexta",   5,
			        "Sábado",  6,
			        "Domingo", 7
			    )
			// WEEKDAY(...,2) => segunda=1 ... domingo=7
			VAR Offset = MOD( WEEKDAY( ThisDate, 2 ) - StartNum, 7 )
			RETURN
			     Offset
			
			```
		formatString: 0
		lineageTag: 794e2eed-000f-45c5-8f24-a861189c5a94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column week_Friday = ```
			
			VAR DiaSemana = WEEKDAY ( d_calendar[Date Key], 2 )   -- 1=Seg ... 7=Dom
			VAR Offset =
			    IF(
			        DiaSemana >= 5,          -- Sexta (5), Sábado (6), Domingo (7)
			        5 - DiaSemana,           -- volta para a sexta desta semana
			        - (DiaSemana + 2)        -- volta para a sexta da semana passada
			    )
			RETURN
			d_calendar[Date Key] + Offset
			
			```
		formatString: Short Date
		lineageTag: a50eb600-42f3-4fbc-914e-3f6c1731e95c
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

