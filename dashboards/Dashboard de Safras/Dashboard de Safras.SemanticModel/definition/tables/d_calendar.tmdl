table d_calendar
	lineageTag: 292194b6-0297-40c3-a4a5-7f66ca3effd2

	measure DiaSemanaAjustado_Medida =
			
			VAR sel = SELECTEDVALUE( NomeSemana[InicioNome], "Segunda" )  -- fallback
			RETURN
			SWITCH(
			    sel,
			    "Segunda", 0,
			    "Terça",   1,
			    "Quarta",  2,
			    "Quinta",  3,
			    "Sexta",   4,
			    "Sábado",  5,
			    "Domingo", 6,
			    0
			)
		formatString: 0
		lineageTag: 1cf212ff-9558-499c-ac6a-9c307e77a5cd

	measure DiaSemanaAjustado_Num_Measure =
			
			VAR DataContext = MAX('d_calendar'[Date Key])
			VAR DiaOriginal = WEEKDAY( DataContext, 2 ) - 1   -- Segunda=0 ... Domingo=6
			VAR InicioSemana = SELECTEDVALUE( NomeSemana[InicioNum])
			RETURN
			MOD( DiaOriginal - InicioSemana + 7, 7 )
		formatString: 0
		lineageTag: e1ab6f1f-0289-4ea8-a61d-17e3d58cf70a

	measure Debug_Selected =
			
			VAR sel = SELECTEDVALUE( NomeSemana[InicioNome], "Segunda" )  -- fallback
			RETURN
			SWITCH(
			    sel,
			    "Segunda", 0,
			    "Terça",   1,
			    "Quarta",  2,
			    "Quinta",  3,
			    "Sexta",   4,
			    "Sábado",  5,
			    "Domingo", 6,
			    0
			)
		formatString: 0
		lineageTag: 1d717218-2a44-445e-9cce-e916394b7e2e

