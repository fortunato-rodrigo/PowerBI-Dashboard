	partition f_operations-741172bb-c926-4890-9da8-bf80d5e491db = m
		mode: import
		queryGroup: Fato
		source =
				let
				    Origem = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation="2.0"]){[Name="prod",Kind="Database"]}[Data], "-----------------------------------------------------#(lf)------------------ Query ScoreCard ------------------#(lf)-----------------------------------------------------#(lf)with acq_afiliado as ( -- cte afiliado da aquisição#(lf)    select id_customer,#(lf)    office_name_affiliate as acq_office#(lf)    from gold.fact_operations#(lf)    where acquisition = true#(lf)    and is_ops_processed#(lf)    and office_name_affiliate is not null#(lf)    and is_intercompany = false#(lf)),#(lf)-----------------------------------------------------#(lf)recorrente_nubank as ( -- CTE para trazer os clientes que em algum momento fizeram alguma operação de recorrência Nubank (HasOffers)#(lf)    select distinct id_customer,#(lf)    'Cliente Recorrente Nubank' as recorrente_nubank#(lf)    from gold.fact_operations#(lf)    where acquisition = false#(lf)    and is_intercompany = false#(lf)    and is_ops_processed#(lf)    and office_name_affiliate = 'Nubank'#(lf)),#(lf)-----------------------------------------------------#(lf)recorrente_afiliado as ( -- CTE para trazer os clientes que em algum momento fizeram alguma operação de recorrência afiliado (HasOffers)#(lf)    select distinct id_customer,#(lf)    'Cliente Recorrente Afiliado (Sem Nubank)' as recorrente_afiliado#(lf)    from gold.fact_operations#(lf)    where acquisition = false#(lf)    and is_intercompany = false#(lf)    and is_ops_processed#(lf)    and is_affiliate = true#(lf)    and office_name_affiliate <> 'Nubank'#(lf))#(lf)-----------------------------------------------------#(lf), monthly_payers AS (#(lf)  SELECT id_customer,#(lf)  month,#(lf)  count(distinct contraparte_ajustada) as unique_payers#(lf)  from (#(lf)  SELECT DISTINCT#(lf)    op.id_customer,#(lf)    DATE_TRUNC('month', op.processed_date) as month,#(lf)    CASE    #(lf)    WHEN op.counterpart = 'Outros' then op.original_counterpart#(lf)    ELSE op.counterpart#(lf)  END as contraparte_ajustada#(lf)  FROM gold.fact_operations as op#(lf)  WHERE op.in_or_out = 'Receiving'#(lf)  AND op.counterpart is not null#(lf)  AND is_ops_processed#(lf)  AND is_intercompany = false    #(lf)  )#(lf)  GROUP BY ALL#(lf))#(lf)-----------------------------------------------------#(lf), high_pj_servicos as ( -- CTE para trazer os clientes que operam apenas em Serviços para o filtro High PJ#(lf)    with temp as (#(lf)        select distinct id_customer,#(lf)        count(distinct case when nature_operation_name = 'Serviços' then nature_operation_name else null end) as natureza_servicos,#(lf)        count(distinct case when nature_operation_name in (#(lf)            'Aluguel de imóvel',#(lf)            'Aporte',#(lf)            'Compra de imóvel',#(lf)            'Empréstimo',#(lf)            'Ganho de capital',#(lf)            'Mercadorias',#(lf)            'Pagamento de dívidas',#(lf)            'Pagamento de locação',#(lf)            'Sociedade Empresarial',#(lf)            'Venda de imóvel'#(lf)            ) then nature_operation_name else null end) as natureza_not_servicos#(lf)        from gold.fact_operations#(lf)        where is_intercompany = false#(lf)        and customer_type = 'PJ'#(lf)        and is_ops_processed#(lf)        group by id_customer#(lf)        ) select distinct id_customer,#(lf)        case when natureza_servicos = 1 and natureza_not_servicos >= 1 then true else false end as high_pj_servicos#(lf)        from temp#(lf))#(lf)---------------------------------------------------#(lf), clientes_diretos_hubspot as -- clientes de prospecção GC#(lf)(#(lf)    select#(lf)  partner_name,#(lf)  owner_name,#(lf)  partnership_details,#(lf)  id_office,#(lf)  case #(lf)    when partnership_details = 'Diretos - PJ'#(lf)      then lpad(regexp_replace(cast(cnpj AS STRING), '[^0-9]', ''), 14, '0') #(lf)    when partnership_details = 'Diretos - PF'#(lf)      then lpad(regexp_replace(cast(cnpj AS STRING), '[^0-9]', ''), 11, '0') #(lf)  end AS cnpj_formatado,#(lf)  creation_date__remap,#(lf)  partnership_details#(lf)  from bronze.hubspot_partners#(lf)  where 1=1#(lf)  and partnership_details like 'Diretos%'#(lf)  qualify row_number() over (partition by cnpj_formatado order by creation_date__remap desc) = 1#(lf)),#(lf)---------------------------------------------------#(lf)#(lf)origem_psu as #(lf)(#(lf)    SELECT#(lf)      clp.customer_id,#(lf)      clp.provider#(lf)    FROM beecambio.beecambio_tbl_customer_login_provider clp#(lf)    JOIN beecambio.beecambio_tbl_customer c #(lf)      ON c.id = clp.customer_id#(lf)    WHERE clp.deleted_at IS NULL#(lf)      AND clp.linked_at_signup = TRUE#(lf)      AND clp.created_at >= '2026-04-01 00:00:00'#(lf)      AND c.deleted = FALSE#(lf)    QUALIFY ROW_NUMBER() OVER(PARTITION BY clp.customer_id ORDER BY clp.created_at DESC) = 1#(lf))#(lf)#(lf)#(lf)select#(lf)  op.id_remittance,#(lf)  op.link_backoffice,#(lf)  op.id_customer,#(lf)  op.bu,#(lf)  op.business_type,#(lf)  op.bu_old,#(lf)  op.business_type_old,#(lf)  op.customer_type,#(lf)  op.processed_date as processing_date,#(lf)  date_trunc('month', date(ac.event_tstamp)) as acquisition_month,#(lf)  date_trunc('month', date(op.psu_date)) as presignup_month,#(lf)  hour(op.processed_tstamp) as processing_hour,#(lf)  minute(op.processed_tstamp) as processing_minute,#(lf)  date_format(op.processed_tstamp, 'HH:mm:00') as processing_hour_minute,#(lf)  op.account_manager,#(lf)  op.is_efx,#(lf)  op.operation_platform_beecambio,#(lf)  op.is_fxaas,#(lf)  op.is_corporate_api,#(lf)  op.is_automatic_operation,#(lf)  op.company_type,#(lf)  sc.company_member_association_type,#(lf)  sc.company_shareholders_count,#(lf)  sc.company_shareholders_with_document,#(lf)  op.acquisition,#(lf)  op.is_partner,#(lf)  coalesce(op.product_from_fxaas, 'REMESSA ONLINE') as product,#(lf)  op.coleta_local,#(lf)  op.country,#(lf)  op.customer_category,#(lf)  op.ops_symbolic_api as ops_simbolicas_api,#(lf)  op.quantity,#(lf)  op.tariff,#(lf)  op.gmv,#(lf)  op.gross_revenue,#(lf)  op.gross_revenue_original,#(lf)  op.diff_gross_revenue,#(lf)  op.gross_profit,#(lf)  case#(lf)    when op.customer_type = 'PF' and op.gmv <= 5000 then '0-5k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 10000 then '5k-10k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 20000 then '10k-20k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 40000 then '20k-40k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 75000 then '40k-75k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 200000 then '75k-200k'#(lf)    when op.customer_type = 'PF' and op.gmv >  200000 then '+200k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 250000 then '0-250k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 500000 then '250k-500k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 1000000 then '500k-1MM'#(lf)    when op.customer_type = 'PJ' and op.gmv >  1000000 then '+1MM'#(lf)  end as ticket_range_v2,#(lf)  case#(lf)    --------------------------------------#(lf)    when op.customer_type = 'PF' and op.gmv <= 5000     then '0-5k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 10000    then '5k-10k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 25000    then '10k-25k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 50000    then '25k-50k'    #(lf)    when op.customer_type = 'PF' and op.gmv <= 130000   then '50k-130k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 270000   then '130k-270k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 500000   then '270k-500k'#(lf)    when op.customer_type = 'PF' and op.gmv <= 1000000  then '500k-1M'#(lf)    when op.customer_type = 'PF' and op.gmv <= 2500000  then '1M-2.5M'#(lf)    when op.customer_type = 'PF' and op.gmv >  2500000  then '+2.5M'#(lf)    --------------------------------------#(lf)    when op.customer_type = 'PJ' and op.gmv <= 10000    then '0-10k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 25000    then ' 10k-25k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 50000    then ' 25k-50k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 100000  then '50k-100k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 200000  then '100k-200k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 400000  then '200k-400k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 600000  then '400k-600k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 800000  then '600k-800k'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 1000000  then '800k-1M'#(lf)    when op.customer_type = 'PJ' and op.gmv <= 2500000  then '1M-2.5M'#(lf)    else 'Other'#(lf)  end as ticket_range_v3,#(lf)  case#(lf)    when op.gross_profit < 0 then 'Com Prejuízo'#(lf)    else 'Sem Prejuízo'#(lf)  end as gross_profit_flag,#(lf)  op.real_message_cost as cost_mensage,#(lf)  op.cost_bank_take as cost_bank_take,#(lf)  op.payout_affiliate as cost_payout_affiliate,#(lf)  op.spread,#(lf)  op.fixed_spread = op.spread as fixed_spread_equal_spread,#(lf)  op.spread_original,#(lf)  op.fixed_spread,#(lf)  op.has_fixed_spread,#(lf)  (op.spread_original - op.spread) * 100 as spread_dif,  #(lf)  CASE#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0 THEN ' Sem Desconto'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.05 THEN 'Desconto até 5%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.10 THEN 'Desconto entre 5% e 10%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.15 THEN 'Desconto entre 10% e 15%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.20 THEN 'Desconto entre 15% e 20%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.25 THEN 'Desconto entre 20% e 25%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.30 THEN 'Desconto entre 25% e 30%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.35 THEN 'Desconto entre 30% e 35%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.40 THEN 'Desconto entre 35% e 40%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.45 THEN 'Desconto entre 40% e 45%'#(lf)    WHEN (op.spread_original - op.spread) * 100 <= 0.50 THEN 'Desconto entre 45% e 50%'#(lf)    ELSE 'Desconto maior de 50%'#(lf)  END as desconto,#(lf)  op.in_or_out,#(lf)  op.segment,#(lf)  op.operation_segment,#(lf)  op.subsegment as high_mid_low,#(lf)  op.nature_operation_name as natureza,#(lf)  op.currency_abbreviation as currency,#(lf)  op.operation_event_type as event_type_ops,#(lf)  op.premium_status as is_premium_user,#(lf)  op.id_purpose_of_remittance as purpose_of_remittance,#(lf)  op.is_comex,#(lf)  op.service_description,#(lf)  op.description_purpose_of_remittance as description_purpose_classification,#(lf)  op.office_name_affiliate as office,#(lf)  op.travel_agency_affiliate,#(lf)  case#(lf)    when op.office_name_affiliate = 'Nubank' and op.processed_date <= '2024-05-18' then 'Nubank Pré-tombamento'#(lf)    when op.office_name_affiliate = 'Nubank' and op.processed_date > '2024-05-18' then 'Nubank Pós-tombamento'#(lf)    else null#(lf)  end as nubank,#(lf)  nu.recorrente_nubank,#(lf)  rf.recorrente_afiliado,#(lf)  af.acq_office,#(lf)  case#(lf)    when op.acquisition = true then 'Aquisição'#(lf)    when op.office_name_affiliate = af.acq_office then 'Com Match - Recorrência de Afiliado e a Aquisição foi do mesmo Afiliado'#(lf)    when op.office_name_affiliate is not null and af.acq_office is not null then 'Sem Match - Recorrência de Afiliado, mas a Aquisição foi de outro Afiliado'#(lf)    when op.office_name_affiliate is null and af.acq_office is not null then 'Recorrência Sem Afiliado e Aquisição foi via Afiliado'#(lf)    when op.office_name_affiliate is not null and af.acq_office is null then 'Recorrência de Afiliado e Aquisição Sem Afiliado'#(lf)    else 'Recorrência e Aquisição Sem Afiliado'#(lf)  end as flag_affiliate,#(lf)  op.reactivation,#(lf)  case#(lf)    when#(lf)      op.customer_type = 'PF'#(lf)      and op.in_or_out = 'Receiving'#(lf)      and op.id_purpose_of_remittance = 67005#(lf)      and op.nature_operation_name = 'Ganho em ações'#(lf)    then true#(lf)    else false#(lf)  end as stock_option,#(lf)  case#(lf)    when op.acquisition then 'ACQUISITION'#(lf)    else 'REPURCHASE'#(lf)  end as event_type,#(lf)  case#(lf)    when op.acquisition then 'Aquisição'#(lf)    else 'Recorrência'#(lf)  end as acq_rec,#(lf)  case#(lf)    when op.mid then 'Mid'#(lf)    else 'Not Mid'#(lf)  end as is_mid,#(lf)  case#(lf)    when op.is_affiliate = true then 'Yes'#(lf)    else 'No'#(lf)  end as is_affiliate,#(lf)  case#(lf)    when op.affiliate_source = '1_hasoffers' then 'Operação de Afiliado - Hasoffers'#(lf)    when op.affiliate_source = '2_applied_discount' then 'Operação de Afiliado - Beecambio'#(lf)    when op.affiliate_source = '3_nubankers' then 'Operação de Afiliado - Ex-Nubank'#(lf)    else 'Operação Sem Afiliado'#(lf)  end as affiliate_source,#(lf)  case#(lf)    when op.voucher_code is not null then true#(lf)    else false#(lf)  end as fl_voucher,#(lf)  op.genre,#(lf)  op.voucher_code,#(lf)  op.swift_or_distributor,#(lf)  op.distributor_name as distributor_name_og,#(lf)  case#(lf)    when op.office_name_affiliate in ('Nubank', 'Vivo Empresas', 'Flash', 'Claro Clube Empresas', 'Banco Linker', 'Strider Inc', 'NinjaTrader') then true#(lf)    else false#(lf)  end as is_parceiros_referral,#(lf)  case#(lf)    op.office_name_affiliate#(lf)    when 'Nubank' then 'Nubank'#(lf)    when 'Vivo Empresas' then 'Vivo'#(lf)    when 'Flash' then 'Flash'#(lf)    when 'Claro Clube Empresas' then 'Claro Clube Empresas'#(lf)    when 'Banco Linker' then 'Banco Linker'#(lf)    when 'Strider Inc' then 'Strider Inc'#(lf)    when 'NinjaTrader' then 'NinjaTrader'#(lf)    else 'Not referral'#(lf)  end as parceiros_referral,#(lf)  case#(lf)    when op.gmv_usd <= 1000 then 1000#(lf)    when op.gmv_usd <= 10000 then 10000#(lf)    when op.gmv_usd <= 100000 then 100000#(lf)    else 1000000#(lf)  end as indece_valor_usd,#(lf)  op.applied_discount,#(lf)  op.applied_discount_1,#(lf)  op.applied_discount_2,#(lf)  op.applied_discount_3,#(lf)  op.mgm_code,#(lf)  op.mgm_operation_type,#(lf)  op.voucher_type,#(lf)  sc.channel_psu as canal,#(lf)  sc.medium_psu as medium,#(lf)  sc.source_psu as source,#(lf)  sc.mkt_campaign_psu as mkt_campaign,#(lf)  sc.first_page_url_psu as page_url,#(lf)  sc.origin_platform_psu,#(lf)  nfc.canal as canal_fc,#(lf)  nfc.medium as medium_fc,#(lf)  nfc.source as source_fc,#(lf)  coalesce(nfc.mkt_campaign, 'organic/direct') as mkt_campaign_fc,#(lf)  op.cnae_subclass as cnae_subclass,#(lf)  op.cnae_session_description as cnae_session,#(lf)  op.cnae_division_description as cnae_division,#(lf)  op.cnae_group_description as cnae_group,#(lf)  op.cnae_class_description as cnae_class,#(lf)  op.company_onboarding_flow,#(lf)  op.onboarding_type,#(lf)  op.remittance_limit_approved,#(lf)  CASE    #(lf)    WHEN op.counterpart = 'Outros' then op.original_counterpart#(lf)    ELSE op.counterpart#(lf)  END as contraparte,#(lf)  CASE#(lf)    WHEN op.counterpart = 'Google' then TRUE#(lf)    ELSE FALSE#(lf)  END AS google,  #(lf)  CASE#(lf)    WHEN unique_payers = 1 THEN 'Profissional'#(lf)    WHEN unique_payers > 1 THEN 'Empreendedor/PME'#(lf)  END as customer_segment,#(lf)  c.mtd,#(lf)  c.workday_processado,#(lf)  c.mtd_calendar_days,#(lf)  op.partner_name_from_maxima_code as partner_name,#(lf)  op.partner_name_from_fxaas,#(lf)    CASE#(lf)        WHEN op.customer_type = 'PJ' THEN#(lf)            CASE#(lf)                WHEN op.nature_operation_name IN ('Serviços de veiculação digital', 'Facilitadora', 'Crypto') THEN false#(lf)                WHEN op.remittance_limit_approved >= 2000000 and any_value(sv.high_pj_servicos) = true THEN true#(lf)                WHEN SUM(op.gmv) >= 2000000 AND op.processed_date >= current_date - INTERVAL '12' MONTH THEN true           #(lf)                WHEN op.gmv >= 260000 THEN true#(lf)                WHEN op.remittance_limit_approved >= 2000000 THEN true#(lf)                WHEN op.operation_segment = 'Capital' AND op.nature_operation_name <> 'Disponibilidade' THEN true#(lf)                WHEN op.nature_operation_name = 'Mercadorias' AND op.gmv >= 3000 THEN true#(lf)                WHEN op.nature_operation_name IN ('Empréstimo', 'Conta investimento', 'Retorno de investimento') THEN true#(lf)                ELSE false#(lf)            END#(lf)        ELSE false#(lf)    END AS high_pj,#(lf)    op.payment_type as payment_method,#(lf)    op.melhor_cambio,#(lf)    sc.city as geo_city,#(lf)    sc.timezone as geo_timezone,#(lf)    upper(sc.state) as geo_state,#(lf)    sc.is_international,#(lf)    case#(lf)      when sc.age < 18 then ' <18'#(lf)      when sc.age between 18 and 24 then ' 18-24'#(lf)      when sc.age between 25 and 34 then ' 25-34'#(lf)      when sc.age between 35 and 44 then ' 35-44'#(lf)      when sc.age between 45 and 54 then ' 45-54'#(lf)      when sc.age between 55 and 64 then ' 55-64'#(lf)      when sc.age > 64 then ' 65+'#(lf)      else 'No info'#(lf)    end as age,#(lf)    op.discount_category,#(lf)    op.recipient_name as corretora,#(lf)    op.bank_name_recipient as bank_name,#(lf)    op.rmi_status as rmi,#(lf)    ia.is_instant,#(lf)    if(csh.cnpj_formatado is not null, true, false) as cliente_prospeccao,#(lf)    op.gmv_usd,#(lf)    op.is_cnr,#(lf)    op.purpose_of_remittance_operation,#(lf)    ps.provider,#(lf)    op.is_potencial_premium,#(lf)    coalesce(bq.onb_ops_type,'S/ resposta') as onb_ops_type,#(lf)    coalesce(bq.onb_reason,'S/ resposta') as onb_reason,#(lf)    current_timestamp() - interval '3' hour as last_update#(lf)from gold.fact_operations as op#(lf)  left join gold.fact_customers as sc on op.id_customer = sc.id_customer#(lf)  left join google_analytics.first_click_sessions as nfc on op.id_customer = nfc.id_customer#(lf)  left join high_pj_servicos as sv on op.id_customer = sv.id_customer#(lf)  left join acq_afiliado as af on op.id_customer = af.id_customer#(lf)  left join recorrente_nubank as nu on op.id_customer = nu.id_customer#(lf)  left join recorrente_afiliado as rf on op.id_customer = rf.id_customer#(lf)  left join monthly_payers as mp on op.id_customer = mp.id_customer and date_trunc('month', op.processed_date) = mp.month#(lf)  left join gold.funnel_event as ac on op.id_customer = ac.id_customer and ac.event_type = 'ACQUISITION'#(lf)  left join bronze.dcalendar as c on c.date_key = op.processed_date#(lf)  left join prod.gold.fast_instant_analysis as ia on op.id_remittance = ia.id_remittance#(lf)  left join silver.customers as c on c.id = sc.id_customer#(lf)  left join clientes_diretos_hubspot as csh on c.cnpj_cpf_client = csh.cnpj_formatado#(lf)  left join origem_psu as ps on op.id_customer = ps.customer_id#(lf)  left join bronze.beecambio_qualification as bq on bq.id_customer = op.id_customer#(lf)where op.is_intercompany = false#(lf)  and op.is_ops_processed = true#(lf)  and op.processed_date >= '2023-01-01'#(lf)  and op.processed_date < current_date#(lf)group by all", null, [EnableFolding=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Origem,{{"id_remittance", type text}, {"id_customer", type text}, {"quantity", Currency.Type}, {"gmv", Currency.Type}, {"gross_revenue", Currency.Type}, {"gross_revenue_original", Currency.Type}, {"diff_gross_revenue", Currency.Type}, {"gross_profit", Currency.Type}, {"cost_mensage", Currency.Type}, {"cost_bank_take", Currency.Type}, {"cost_payout_affiliate", Currency.Type}, {"spread", Percentage.Type}, {"spread_original", Percentage.Type}, {"spread_dif", Percentage.Type}, {"tariff", Currency.Type}})
