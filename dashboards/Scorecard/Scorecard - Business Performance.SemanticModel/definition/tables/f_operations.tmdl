	column cnae_class
		dataType: string
		lineageTag: e1c18d08-7de0-47ca-9fef-d5ea3551bb11
		summarizeBy: none
		sourceColumn: cnae_class

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Ticket Range' = ```
			
			SWITCH(
			    
			    TRUE(),
			
			    --PF Default
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] <= 5000,
			    "a) 0-5k",
			
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] <= 10000,
			    "b) 5k-10k",
			
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] <= 20000,
			    "c) 10k-20k",
			
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] <= 40000,
			    "d) 20k-40k",
			
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] <= 75000,
			    "e) 40k-75k",
			
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] <= 200000,
			    "f) 75k-200k",
			
			    f_operations[customer_type] = "PF" &&
			    [AVG Ticket GMV] > 200000,
			    "g) +200k",
			    
			    --Comex
			    f_operations[customer_type] = "PJ" &&
			    f_operations[natureza] = "Mercadorias" &&
			    [AVG Ticket GMV] <= 20000,
			    "l) 0-20k",
			
			    f_operations[customer_type] = "PJ" &&
			    f_operations[natureza] = "Mercadorias" &&
			    [AVG Ticket GMV] <= 150000,
			    "m) 20k-150k",
			
			    f_operations[customer_type] = "PJ" &&
			    f_operations[natureza] = "Mercadorias" &&
			    [AVG Ticket GMV] <= 250000,
			    "n) 150k-250k",
			
			    f_operations[customer_type] = "PJ" &&
			    f_operations[natureza] = "Mercadorias" &&
			    [AVG Ticket GMV] > 250000,
			    "o) +250k",
			
			    --Capital
			    f_operations[customer_type] = "PJ" &&
			    f_operations[operation_segment] = "Capital" &&
			    [AVG Ticket GMV] <= 250000,
			    "p) 0-250k",
			
			    f_operations[customer_type] = "PJ" &&
			    f_operations[operation_segment] = "Capital" &&
			    [AVG Ticket GMV] <= 1000000,
			    "q) 250k-1M",
			
			    f_operations[customer_type] = "PJ" &&
			    f_operations[operation_segment] = "Capital" &&
			    [AVG Ticket GMV] > 1000000,
			    "r) +1M",
			
			    --PJ Default
			    f_operations[customer_type] = "PJ" &&
			    --scorecard_operations[operation_segment] = "Serviços" &&
			    [AVG Ticket GMV] <= 25000,
			    "h) 0-25k",
			
			    f_operations[customer_type] = "PJ" &&
			    --scorecard_operations[operation_segment] = "Serviços" &&
			    [AVG Ticket GMV] <= 100000,
			    "i) 25k-100k",
			
			    f_operations[customer_type] = "PJ" &&
			    --scorecard_operations[operation_segment] = "Serviços" &&
			    [AVG Ticket GMV] <= 200000,
			    "j) 100k-200k",
			
			    f_operations[customer_type] = "PJ" &&
			    --scorecard_operations[operation_segment] = "Serviços" &&
			    [AVG Ticket GMV] > 200000,
			    "k) +200k",
			
			    "Tratar"
			   --
			)
			```
		lineageTag: 3409c875-a30e-4984-9fcb-86cc4a4f8861
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

