table 'Month over month'
	lineageTag: 821a69c1-2d83-43c3-b417-99289f8cd357

	calculationGroup

		calculationItem 'Período Anterior' =
				
				SWITCH(
				    TRUE(),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Dia", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, DAY)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Mês", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, MONTH)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Ano", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, YEAR)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Quarter", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, QUARTER)),
				    BLANK()
				)

		calculationItem 'Growth #' = ```
				
				VAR current_value = SELECTEDMEASURE()
				VAR previous_value = 
				SWITCH(
				    TRUE(),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Dia", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, DAY)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Mês", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, MONTH)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Ano", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, YEAR)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Quarter", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, QUARTER)),
				    BLANK()
				    )
				RETURN
				current_value - previous_value
				```

		calculationItem 'Growth %' = ```
				
				VAR current_value = SELECTEDMEASURE()
				VAR previous_value = 
				SWITCH(
				    TRUE(),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Dia", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, DAY)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Mês", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, MONTH)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Ano", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, YEAR)),
				    SELECTEDVALUE('p_timeframe'[SelectedValue]) = "por Quarter", CALCULATE(SELECTEDMEASURE(), DATEADD(d_calendar[Date Key], -1, QUARTER)),
				    BLANK()
				    )
				RETURN
				DIVIDE(
				    (current_value - previous_value),
				    previous_value,
				    BLANK()
				)
				```

			formatStringDefinition = "0.0%"

		calculationItem 'Conditional - Gross Revenue' =
				
				IF(
				    SELECTEDVALUE('Month over month'[Coluna do grupo de cálculo]) in {"Growth #", "Growth #"},
				    SELECTEDMEASURE(),
				    BLANK()
				)

		calculationItem Realizado = SELECTEDMEASURE()

	measure 'Color - GMV' =
			
			IF (
			    SELECTEDVALUE('Month over month'[Coluna do grupo de cálculo]) IN {"Growth #", "Growth %"},
			    [GMV],
			    BLANK ()
			)
		lineageTag: 55878184-c42f-4b40-9762-ae1b57e0eceb

