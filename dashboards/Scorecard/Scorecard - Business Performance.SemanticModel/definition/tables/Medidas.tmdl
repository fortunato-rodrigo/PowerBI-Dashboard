	measure 'Diff Gross Revenue Anterior' = ```
			
			VAR vTimeframe = SELECTEDVALUE(p_timeframe[SelectedValue])
			VAR IsMTDSelected = SELECTEDVALUE(d_calendar[mtd])
			
			-- Calcular GMV do período anterior com controle explícito de MTD
			VAR vPreviousMonth = 
			    IF(
			        IsMTDSelected = TRUE(),
			        CALCULATE([Diff Gross Revenue], PARALLELPERIOD('d_calendar'[Date Key], -1, MONTH), d_calendar[mtd] = TRUE()),
			        CALCULATE([Diff Gross Revenue], PARALLELPERIOD('d_calendar'[Date Key], -1, MONTH), REMOVEFILTERS(d_calendar[mtd]))
			    )
			
			VAR vPreviousDay = 
			    IF(
			        IsMTDSelected = TRUE(),
			        CALCULATE([Diff Gross Revenue], DATEADD('d_calendar'[Date Key], -1, DAY), d_calendar[mtd] = TRUE()),
			        CALCULATE([Diff Gross Revenue], DATEADD('d_calendar'[Date Key], -1, DAY), REMOVEFILTERS(d_calendar[mtd]))
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    vTimeframe = "por Dia", vPreviousDay,
			    vTimeframe = "por Mês", vPreviousMonth,
			    BLANK()
			)
			```
