	measure 'Gross Revenue Original Anterior' = ```
			
			VAR vTimeframe = SELECTEDVALUE(p_timeframe[SelectedValue])
			VAR IsMTDSelected = SELECTEDVALUE(d_calendar[mtd])
			
			-- Calcular GMV do período anterior com controle explícito de MTD
			VAR vPreviousMonth = 
			    IF(
			        IsMTDSelected = TRUE(),
			        CALCULATE([Gross Revenue Original], PARALLELPERIOD('d_calendar'[Date Key], -1, MONTH), d_calendar[mtd] = TRUE()),
			        CALCULATE([Gross Revenue Original], PARALLELPERIOD('d_calendar'[Date Key], -1, MONTH), REMOVEFILTERS(d_calendar[mtd]))
			    )
			
			VAR vPreviousDay = 
			    IF(
			        IsMTDSelected = TRUE(),
			        CALCULATE([Gross Revenue Original], DATEADD('d_calendar'[Date Key], -1, DAY), d_calendar[mtd] = TRUE()),
			        CALCULATE([Gross Revenue Original], DATEADD('d_calendar'[Date Key], -1, DAY), REMOVEFILTERS(d_calendar[mtd]))
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    vTimeframe = "por Dia", vPreviousDay,
			    vTimeframe = "por Mês", vPreviousMonth,
			    BLANK()
			)
			```
		displayFolder: Realizado\Gross
		lineageTag: 96c24fd7-7ad7-49d4-a725-7b6af65881a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Revenue Original Growth' =
			
			DIVIDE(
			    [Gross Revenue Original] - [Gross Revenue Original Anterior],
			    [Gross Revenue Original Anterior],
