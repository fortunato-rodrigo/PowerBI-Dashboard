		source =
				let
				    Fonte = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation=null]){[Name="prod",Kind="Database"]}[Data], "select #(lf)c.id as id_customer,#(lf)mp.name as partner_name#(lf)from beecambio.beecambio_tbl_customer c#(lf)inner join beecambio.beecambio_maxima_partners as mp #(lf)#(tab)on mp.partner_code = c.maxima_partner_code#(lf)where 1=1 #(lf)and c.maxima_partner_code is not null", null, [EnableFolding=true])
