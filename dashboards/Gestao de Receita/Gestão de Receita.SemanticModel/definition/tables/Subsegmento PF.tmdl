	partition 'Subsegmento PF' = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, EnableAutomaticProxyDiscovery=null]){[Name="prod",Kind="Database"]}[Data], "SELECT #(lf)#(tab)  s.id_customer,#(lf)#(tab)  date(s.month) as month_id,#(lf)    s.subsegment#(lf)#(tab)FROM stage.dim_last_subsegments  as s#(lf)  left join silver.customers as c#(lf)  on c.id = s.id_customer#(lf)  where c.customer_type = 'PF'", null, [EnableFolding=true])
