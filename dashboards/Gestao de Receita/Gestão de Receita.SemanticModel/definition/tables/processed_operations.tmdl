	column 'Desconto aplicado' =
			
			IF(
			    processed_operations[applied_discount] = "DISCOUNT NOT APPLIED",
			    "Sem desconto",
			        IF(
			            processed_operations[applied_discount] = BLANK(),
			            "Vazio",
			            IF(
			                CONTAINSSTRING(processed_operations[applied_discount],"produccine") = TRUE(),
			                "Produccine",
			                IF(
			                    CONTAINSSTRING(processed_operations[applied_discount],"nubank") = TRUE(),
			                    "Nubank",
			                    "Com desconto"
			                )
			            )
			        )
			)
