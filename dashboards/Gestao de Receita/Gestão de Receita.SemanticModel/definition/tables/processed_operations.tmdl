		annotation SummarizationSetBy = Automatic

	partition processed_operations = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, QueryTags=null, EnableAutomaticProxyDiscovery=null, Implementation=null]){[Name="prod",Kind="Database"]}[Data], "with gmv_mensal as #(lf)( #(lf)  select#(lf)  date_trunc('month',po.processed_date) mes,#(lf)  sum(po.gmv) as gmv#(lf)  from gold.fact_operations po #(lf)  group by all #(lf)) #(lf)select#(lf)  po.id_remittance,#(lf)  po.in_or_out,#(lf)  po.id_customer,#(lf)  po.gmv,#(lf)  po.gross_revenue,#(lf)  po.is_ops_processed,#(lf)  po.processed_date,#(lf)  po.nature_operation_name,#(lf)  po.customer_type,#(lf)  po.business_type,#(lf)  po.bu,#(lf)  po.distributor_name,#(lf)  po.is_affiliate,#(lf)  po.MID,#(lf)  po.currency_abbreviation,#(lf)  po.currency_name,#(lf)  po.has_fixed_spread,#(lf)  po.is_intercompany,#(lf)  po.applied_discount,#(lf)  po.spread,#(lf)  po.spread_original,#(lf)  po.taxes,#(lf)  po.swift_or_distributor,#(lf)  po.acquisition,#(lf)  po.country,#(lf)  po.real_message_cost,#(lf)  po.tariff,#(lf)  po.voucher_code,#(lf)  po.net_revenue,#(lf)  ro.policy_label,#(lf)  po.payout_affiliate ,#(lf)  po.spread_revenue,#(lf)  po.is_efx,#(lf)  po.is_partner,#(lf)  po.is_corporate_api,#(lf)  po.is_fxaas,#(lf)  CASE#(lf)    WHEN po.counterpart = 'Google' then TRUE#(lf)    ELSE FALSE#(lf)  END AS google, #(lf)  gm.gmv                                              as gmv_total_mes,#(lf)  po.gmv / gm.gmv                                     as prop_gmv,#(lf)  po.cost_bank_take                                   as bank_take,#(lf)  coalesce(po.real_message_cost,0)                    as despesa_real,#(lf)  po.payout_affiliate                                 as payout,#(lf)  po.partner_commissioning,#(lf)  po.cost_bacen,#(lf)  po.cost_funding,#(lf)  po.net_revenue                                      as lucro,#(lf)  coalesce(po.partner_name_from_maxima_code,po.partner_name_from_fxaas) as partner_name,#(lf)  current_timestamp() - interval '3' hour as last_update#(lf)from gold.fact_operations as po#(lf)  left join beecambio.beecambio_tbl_remittance_operation as ro on ro.id = po.id_remittance #(lf)  --left join select * from stage.dim_monthly_messaging_cost as mm on mm.id_remittance = po.id_remittance#(lf)  left join gmv_mensal as gm on date_trunc('month',po.processed_date) = gm.mes #(lf)where 1=1 #(lf)  and date_trunc('month',po.processed_date) >= date('2024-01-01')#(lf)  and date_trunc('month',po.processed_date) <= date_trunc('month',current_date)", null, [EnableFolding=true]),
				    #"Colunas Renomeadas" = Table.RenameColumns(Fonte,{{"nature_operation_name", "natureza"}})
				in
				    #"Colunas Renomeadas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

