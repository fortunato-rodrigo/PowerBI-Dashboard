	column 'Faixa Spread' =
			
			VAR Spread = processed_operations[spread]  -- substitua pelo nome real da coluna
			RETURN
			    SWITCH(
			        TRUE(),
			        Spread < 0, "0 - Negativo",
			        Spread = 0, "1 - 0%",
			        Spread < 0.002, "2 - 0% a 0,2%",
			        Spread < 0.004, "3 - 0,2% a 0,4%",
			        Spread < 0.006, "4 - 0,4% a 0,6%",
			        Spread < 0.008, "5 - 0,6% a 0,8%",
			        Spread < 0.010, "6 - 0,8% a 1,0%",
			        Spread < 0.012, "7 - 1,0% a 1,2%",
			        "8 - Acima de 1,2%"
			    )
		lineageTag: de65bc37-c1a6-4312-a957-d03d2d755412
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column perc_mensageria = processed_operations[real_message_cost] / processed_operations[gross_revenue]
		lineageTag: 69c0f044-7321-46f1-a7da-26febeb82283
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Faixa perc_mensageria' = ```
			
			VAR Perc = [perc_mensageria]  -- substitua pelo nome exato da coluna
			RETURN
			    SWITCH(
			        TRUE(),
			        Perc < 0, "0 - Negativo",
			        Perc < 0.2, "1 - 0% a 20%",
			        Perc < 0.4, "2 - 20% a 40%",
			        Perc < 0.6, "3 - 40% a 60%",
			        Perc < 0.8, "4 - 60% a 80%",
			        Perc < 0.9, "5 - 80% a 90%",
			        "8 - Acima de 90%"
			    )
			
			```
		lineageTag: daefca4a-3a22-46b3-83dc-3fbdd791b77c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column spread_calculado = processed_operations[gross_revenue] / processed_operations[gmv]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 525cd8e9-e3c8-4ff0-b455-f134ac848d1e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Class Spread Real' =
			
			VAR Spread = processed_operations[spread]  -- substitua pelo nome real da coluna
			VAR Spread_calc = processed_operations[spread_calculado]
			RETURN
			    SWITCH(
			        TRUE(),
			        Spread < Spread_calc, "Spread Real Maior",
			        Spread = Spread_calc, "Spread Real igual",
			        "Spread Real menor"
			    )
		lineageTag: c0328a33-712b-4422-965d-0cacc8aa5d90
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

