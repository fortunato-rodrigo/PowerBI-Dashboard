	column 'Ticket Range' = ```
			
			SWITCH(
			    
			   TRUE(),
			
			    --PF Default
			    processed_operations[gmv] < 1200,
			    "a) 0-1200",
			
			    processed_operations[gmv] <= 3000,
			    "b) 1200-3000",
			
			    processed_operations[gmv] <= 5000,
			    "c) 3000-5000",
			
			    processed_operations[gmv] <= 10000,
			    "d) 5000-10000",
			
			    processed_operations[gmv] <= 15000,
			    "e) 10000-15000",
			
			    processed_operations[gmv] <= 20000,
			    "f) 15000-20000",
			
			    processed_operations[gmv] <= 30000,
			    "g) 20000-30000",
			
			    "h) +30000"
			   --
			)
			```
