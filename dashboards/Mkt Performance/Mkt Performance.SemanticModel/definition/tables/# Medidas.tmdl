	measure P1 =
			
			IF (
			    HASONEVALUE(t_Tabela[KPI]),
			    SWITCH (
			        VALUES (t_Tabela[KPI]),
			        "GMV", [GMV P1],
			        "Receita", [Receita P1],
			        "Operações", [OPS P1],
			        "Presignups", [PSU P1],
			        "Signups", [SU P1],
			        "Ticket Médio", [Ticket P1]
			    ),
			    BLANK()
			)
		displayFolder: Comparações\_Oficial
