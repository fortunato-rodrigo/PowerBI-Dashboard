	measure GMV =
			
			CALCULATE(
			    SUM(f_mkt_performance[gmv]),
			    FILTER(f_mkt_performance,
			        f_mkt_performance[event_type] in {"ACQUISITION", "OPERATION"}
			    )
			) --+ 0
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Performance
		lineageTag: 8c4f7c49-9429-4aeb-9848-513bbf7ad865

