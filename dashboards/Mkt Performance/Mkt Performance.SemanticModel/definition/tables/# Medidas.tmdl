	measure 'GMV - ∆ P1 x P2' = [GMV P1] - [GMV P2]
		displayFolder: Comparações\GMV
		lineageTag: eacae181-f3e1-4def-9530-8853bd531d2f

		formatStringDefinition = ```
				VAR vValor = SELECTEDMEASURE()
				VAR vFormat = 
				SWITCH(
				    TRUE(),
				    vValor >= 1000000000, "R$ #,#0,,,.00B;-R$ #,#0,,,.00B",
				    vValor >= 1000000, "R$ #,#0,,.00M;-R$ #,#0,,.00M",
				    vValor >= 1000, "R$ #,#0,.00K;-R$ #,#0,.00K",
				    vValor <= -1000000000, "R$ #,#0,,,.00B;R$ #,#0,,,.00B",
				    vValor <= -1000000, "R$ #,#0,,.00M;R$ #,#0,,.00M",
				    vValor <= -1000, "R$ #,#0,.00K;R$ #,#0,.00K",
				    "R$ #,0.00;R$ #,0.00"
				)
				RETURN 
				"""" & FORMAT(SELECTEDMEASURE(), vFormat) & """"
				```

	measure 'GMV - ∆ P1 x P3' = [GMV P1] - [GMV P3]
