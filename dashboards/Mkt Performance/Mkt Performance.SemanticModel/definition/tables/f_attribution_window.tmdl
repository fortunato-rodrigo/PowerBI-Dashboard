	partition f_attribution_window = m
		mode: import
		queryGroup: Fato
		source =
				let
				    Origem = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, EnableAutomaticProxyDiscovery=null]){[Name="prod",Kind="Database"]}[Data], "select distinct#(lf)  date(aw.event_date) as event_date,#(lf)  case#(lf)    when aw.mkt_campaign like '%pmax%'#(lf)    then 'display'#(lf)    else coalesce(aw.canal, 'unknown')#(lf)  end as canal,#(lf)  coalesce(aw.source, 'unknown') as source,#(lf)  coalesce(aw.medium, 'unknown') as medium,#(lf)  coalesce(trim(aw.mkt_campaign), 'organic/direct') as mkt_campaign,#(lf)  lower(coalesce(c.utm_adgroup_psu, 'unknown')) as ad_group_lc,#(lf)  dc.customer_type,#(lf)  count(distinct case when aw.event = 'PRESIGNUP'   then aw.id_customer else null end) as presignups,#(lf)  count(distinct case when dc.customer_type = 'PF' and aw.event = 'PRESIGNUP'   then aw.id_customer else null end) as presignups_pf,#(lf)  count(distinct case when dc.customer_type = 'PJ' and aw.event = 'PRESIGNUP'   then aw.id_customer else null end) as presignups_pj,#(lf)  count(distinct case when aw.event = 'ACQUISITION' then aw.id_customer else null end) as acquisitions,#(lf)  count(distinct case when dc.customer_type = 'PF' and aw.event = 'ACQUISITION' then aw.id_customer else null end) as acquisitions_pf,#(lf)  count(distinct case when dc.customer_type = 'PJ' and aw.event = 'ACQUISITION' then aw.id_customer else null end) as acquisitions_pj#(lf)from google_analytics.attribution_window as aw#(lf)  inner join silver.customers as dc on aw.id_customer = dc.id#(lf)  left join google_analytics.last_click_sessions as lc on aw.session_id = lc.session_id#(lf)  left join gold.fact_customers as c on dc.id = c.id_customer#(lf)where date(aw.event_date) >= '2023-08-01'#(lf)  and lc.session_id is null#(lf)group by all", null, [EnableFolding=true])
				in
				    Origem

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

