	partition f_orders-f55a1bfd-b279-41cb-bf08-711c8d8663d2 = m
		mode: import
		source =
				let
				  Origem = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, EnableAutomaticProxyDiscovery=null]){[Name="prod",Kind="Database"]}[Data], "with share_banking as (#(lf)    select#(lf)      *#(lf)      except(sequence, event_timestamp)#(lf)    from (#(lf)      select#(lf)        *,#(lf)        row_number() over (partition by user_id order by event_timestamp asc) as sequence#(lf)      from (#(lf)        select#(lf)          user_id,#(lf)          platform as share_banking_platform,#(lf)          label as share_banking_label,#(lf)          event_timestamp,#(lf)          date(event_timestamp) as share_banking_date#(lf)        from google_analytics.ga4_web_event_attribution#(lf)        where#(lf)          event_name = 'share_bank_details'#(lf)          and user_id is not null#(lf)#(lf)        union#(lf)#(lf)        select#(lf)          user_id,#(lf)          platform as share_banking_platform,#(lf)          label as share_banking_label,#(lf)          event_timestamp,#(lf)          date(event_timestamp) as share_banking_date#(lf)        from google_analytics.ga4_app_event_attribution#(lf)        where#(lf)          event_name = 'share_bank_details'#(lf)          and user_id is not null#(lf)      )#(lf)    )#(lf)    where sequence = 1#(lf)),#(lf)#(lf)segmentation as (#(lf)    select#(lf)      month,#(lf)      id_customer,#(lf)      subsegment as last_subsegment,#(lf)      row_number() over (partition by id_customer order by month desc) as row_number#(lf)    from stage.dim_monthly_subsegmentation#(lf)),#(lf)#(lf)last_informations as (#(lf)    select#(lf)      p.id_customer,#(lf)      p.bu as last_bu,#(lf)      p.business_type as last_business_type,#(lf)      p.operation_segment as last_operation_segment,#(lf)      p.segment as last_segment,#(lf)      p.nature_operation_name as last_nature,#(lf)      p.processed_date as last_operation,#(lf)      row_number() over (partition by p.id_customer order by p.processed_tstamp desc) as row_number#(lf)    from gold.fact_operations as p#(lf)    where p.is_ops_processed#(lf)),#(lf)#(lf)aquisicao as (#(lf)    select distinct#(lf)      fo.id_customer#(lf)    from gold.fact_operations as fo#(lf)    where is_ops_processed is true#(lf))#(lf)#(lf)select distinct#(lf)    do.*,#(lf)    do.aggregate_order_status as status_ordem_resumo,#(lf)    do.order_redeemed_in_the_same_month as resgate_mesmo_mes,#(lf)    date_trunc('hour', do.created_tstamp) as data_hora_criacao_ordem,#(lf)    case#(lf)      when do.customer_type = 'PF' then 'PF'#(lf)      else coalesce(b.company_onboarding_flow, 'offline')#(lf)    end as company_onboarding_flow,#(lf)    coalesce(ma.is_premium, false) as premium_status,#(lf)    do.financial_institution_number as external_financial_institution_id,#(lf)    coalesce(po.eligible_coleta_local, false) as elegivel_coleta_local,#(lf)    po.processed_date,#(lf)    po.quantity as valor_me,#(lf)    po.gmv as gmv,#(lf)    po.gross_revenue,#(lf)    coalesce(sb.share_banking_platform, 'No information') as share_banking_platform,#(lf)    coalesce(sb.share_banking_label, 'No information') as share_banking_label,#(lf)    date(do.redemption_tstamp) as redemption_date,#(lf)    sb.share_banking_date,#(lf)    date(ac.event_tstamp) as acquisition_date,#(lf)    date(ps.event_tstamp) as presignup_date,#(lf)    po.bu,#(lf)    po.voucher_code as cupom_desconto,#(lf)    case#(lf)      when po.voucher_code is null then 'Sem Cupom'#(lf)      else 'Cupom desconto'#(lf)    end as desconto,#(lf)    case#(lf)      when po.acquisition#(lf)        or a.id_customer is null then 'Aquisição'#(lf)      else 'Recorrência'#(lf)    end as funil,#(lf)    if(do.id_financial_institution = 3, 'Topázio','Master') as instituicao_financeira,#(lf)    li.last_bu,#(lf)    li.last_business_type,#(lf)    li.last_segment,#(lf)    li.last_operation_segment,#(lf)    sg.last_subsegment,#(lf)    li.last_nature,#(lf)    li.last_operation,#(lf)    case#(lf)      when b.onboarding_type in ('instant', 'fast') then 'instant'#(lf)      else b.onboarding_type#(lf)    end as onboarding_type,#(lf)    case#(lf)      when do.counterpart is not null then do.counterpart#(lf)      else 'Outros'#(lf)    end as contraparte_ajustada_para_ranking_final,#(lf)    coalesce(lc.canal, nlc.canal) as canal,#(lf)    coalesce(lc.source, nlc.source) as source,#(lf)    coalesce(lc.medium, nlc.medium) as medium,#(lf)    coalesce(lc.mkt_campaign, nlc.mkt_campaign) as mkt_campaign,#(lf)    dc.mtd,#(lf)    dc.mtd_calendar_days,#(lf)    now() - interval '3' hour as data_atualizacao#(lf)from silver.orders as do#(lf)left join beecambio.beecambio_tbl_payment_order as od#(lf)  on do.id = od.id#(lf)left join prod.beecambio.beecambio_tbl_customer b#(lf)  on do.id_customer = b.id#(lf)left join stage.dim_monthly_premium as ma#(lf)  on do.id_customer = ma.id_customer#(lf)     and date_trunc('MONTH', ma.month) = date_trunc('MONTH', do.created_date)#(lf)left join gold.fact_operations as po#(lf)  on do.id_remittance = po.id_remittance#(lf)     and po.is_ops_processed#(lf)left join aquisicao as a#(lf)  on do.id_customer = a.id_customer#(lf)left join gold.funnel_event as ac#(lf)  on do.id_customer = ac.id_customer#(lf)     and ac.event_type = 'ACQUISITION'#(lf)left join gold.funnel_event as ps#(lf)  on do.id_customer = ps.id_customer#(lf)     and ps.event_type = 'PRESIGNUP'#(lf)left join share_banking as sb#(lf)  on do.id_customer = sb.user_id#(lf)left join last_informations as li#(lf)  on do.id_customer = li.id_customer#(lf)     and li.row_number = 1#(lf)left join segmentation as sg#(lf)  on do.id_customer = sg.id_customer#(lf)     and sg.row_number = 1#(lf)left join legacy.last_click_old as lc#(lf)  on do.id_customer = lc.id_customer#(lf)     and lc.presignup_date < '2023-08-01'#(lf)left join google_analytics.last_click_sessions as nlc#(lf)  on do.id_customer = nlc.id_customer#(lf)     and nlc.event_date >= '2023-08-01'#(lf)left join bronze.dcalendar as dc#(lf)  on date(do.created_date) = dc.date_key#(lf)where do.created_date >= '2024-01-01'#(lf)  and boolean(od.deleted) = false#(lf)  and lower(do.counterpart) not like '%remessa online%'", null, [EnableFolding=true]),
				    #"Tipo de coluna alterado" = Table.TransformColumnTypes(Origem, {{"id_customer", type text}, {"id_remittance", type text}, {"id", type text}}),
				  #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo de coluna alterado",{{"customer_type", "Customer Type"}, {"original_counterpart", "Remetente"}, {"instituicao_financeira", "Instituição Financeira"}, {"counterpart", "Contraparte Ajustada"}, {"contraparte_ajustada_para_ranking_final", "Contraparte"}})
				in
				    #"Colunas Renomeadas"

	annotation PBI_ResultType = Exception

	annotation PBI_NavigationStepName = Navegação

