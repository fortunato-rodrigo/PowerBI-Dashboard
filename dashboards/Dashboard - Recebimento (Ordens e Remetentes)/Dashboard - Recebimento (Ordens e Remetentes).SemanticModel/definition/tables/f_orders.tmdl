		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"f_orders","TableItemName":"data_hora_criacao_ordem (compartimentos)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'data_hora_criacao_ordem (compartimentos)' =
			IF(
				ISBLANK('f_orders'[data_hora_criacao_ordem]),
				BLANK(),
				INT('f_orders'[data_hora_criacao_ordem] * 24) / 24
			)
		dataType: dateTime
		formatString: General Date
