	column 'Resgate no mesmo mês' = ```
			
			    SWITCH(
			        TRUE(),
			        f_orders[resgate_mesmo_mes] = TRUE(),
			        "Resgate no mesmo mês",
			        "Não resgatada no mesmo mês"
			    )
			```
		lineageTag: f013668d-005e-4e01-8a7b-f365122c7c72
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Google = ```
			
			    SWITCH(
			        TRUE(),
			        f_orders[Remetente] = "Google Llc",
			        "Somente Google",
			        "Sem Google"
			    )
			```
		lineageTag: 3892ec84-8366-4ebd-a80f-1858b77e95de
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column currency_key = CONCATENATE(f_orders[currency], f_orders[created_date])
		isHidden
		lineageTag: b35fb5d2-900d-4292-b96b-95331d6bee6e
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column trading = ```
			
			    LOOKUPVALUE(
			        d_trading_quotation[trading_quotation],
			        d_trading_quotation[currency_key],
			        f_orders[currency_key]
			    )
			```
		lineageTag: 097814e5-8055-4d87-b54d-29433b2f8d85
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column gmv_forecast = f_orders[quantity] * f_orders[trading]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 99e950bd-706f-4cc9-afe5-59f83a0fad4c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column gross_revenue_forecast = f_orders[quantity] * 0.0083
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d4022dac-48dc-43e7-bcf7-39586e2e2666
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column 'Prazo de Resgate' = ```
			
			    SWITCH(
			        TRUE(),
			        DATEDIFF(
			            f_orders[created_date],
			            NOW(),
			            DAY
			        ) <= 180,
			        "Menor 180d",
			        "Maior 180d"
			    )
			```
		lineageTag: adb7cedb-7ebf-4d2c-9c09-7e053ee9b01d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

