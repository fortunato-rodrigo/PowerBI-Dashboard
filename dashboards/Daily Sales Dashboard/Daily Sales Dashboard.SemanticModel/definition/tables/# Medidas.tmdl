	measure Acumulado =
			
			IF(
			    SELECTEDVALUE('dcalendar'[is_current_date]) = TRUE,
			    BLANK(),
			    CALCULATE(
			        [Realizado],
			        FILTER(
			            ALL('dcalendar'),
			            'dcalendar'[Date Key] <= MAX('f_gold_ops'[operation_date]) &&
			            'dcalendar'[date_month] = MAX('dcalendar'[date_month]) &&
			            NOT('dcalendar'[is_current_date])
			        )
			    )
			)
		displayFolder: # Oficial\Realizado
