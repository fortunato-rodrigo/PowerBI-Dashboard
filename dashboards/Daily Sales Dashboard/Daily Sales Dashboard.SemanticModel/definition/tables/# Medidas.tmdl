	measure Realizado = ```
			
			VAR vIntraday = SELECTEDVALUE('Intraday Flag'[Intraday])
			VAR vKPI = SELECTEDVALUE(Tabela[KPI])
			RETURN
			SWITCH(
			    
			    TRUE(),
			    
			    vKPI = "GMV" && vIntraday = FALSE(), CALCULATE([GMV], dcalendar[is_current_date] = FALSE()),
			    vKPI = "Receita" && vIntraday = FALSE(), CALCULATE([Receita], dcalendar[is_current_date] = FALSE()),
			    vKPI = "Operações" && vIntraday = FALSE(), CALCULATE([Ops], dcalendar[is_current_date] = FALSE()),
			    vKPI = "Presignups" && vIntraday = FALSE(), CALCULATE([Presignups], dcalendar[is_current_date] = FALSE()),
			    vKPI = "Investimento" && vIntraday = FALSE(), CALCULATE([Investimento], dcalendar[is_current_date] = FALSE()),
			    vKPI = "CPP" && vIntraday = FALSE(), CALCULATE([CPP], dcalendar[is_current_date] = FALSE()),
			    vKPI = "CPA" && vIntraday = FALSE(), CALCULATE([CPA], dcalendar[is_current_date] = FALSE()),
			    vKPI = "PNL" && vIntraday = FALSE(), CALCULATE([PNL], dcalendar[is_current_date] = FALSE()),
			
			    vKPI = "GMV" && vIntraday = TRUE(), [GMV],
			    vKPI = "Receita" && vIntraday = TRUE(), [Receita],
			    vKPI = "Operações" && vIntraday = TRUE(), [Ops],
			    vKPI = "Presignups" && vIntraday = TRUE(), [Presignups],
			    vKPI = "Investimento" && vIntraday = TRUE(), [Investimento],
			    vKPI = "CPP" && vIntraday = TRUE(), [CPP] ,
			    vKPI = "CPA" && vIntraday = TRUE(), [CPA],
			    vKPI = "PNL" && vIntraday = TRUE(), [PNL]
			
			)
			```
		displayFolder: # Oficial\Realizado
		lineageTag: a84c5b72-2269-47a6-b3d1-affeb476c4dc

		formatStringDefinition = ```
				VAR vValor = SELECTEDMEASURE()
				VAR vMeasure = SELECTEDVALUE(Tabela[KPI])
				VAR vFormat = 
				SWITCH(
				    TRUE(),
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 1000000000, "R$ #,#0,,,.00B;-R$ #,#0,,,.00B",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 1000000, "R$ #,#0,,.00M;-R$ #,#0,,.00M",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 1000, "R$ #,#0,.00K;-R$ #,#0,.00K",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 0, "R$ #,0;R$ #,0",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor <= -1000000000, "R$ #,#0,,,.00B;R$ #,#0,,,.00B",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor <= -1000000, "R$ #,#0,,.00M;R$ #,#0,,.00M",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor <= -1000, "R$ #,#0,.00K;R$ #,#0,.00K",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor < 0, "R$ #,0.00;R$ #,0.00",
				    vMeasure in {"CPP", "CPA"}, "R$ #,0.00;R$ #,0.00",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 1000000000, "#,#0,,,.00B;-#,#0,,,.00B",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 1000000, "#,#0,,.00M;-#,#0,,.00M",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 1000, "#,#0,.00K;-#,#0,.00K",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 0, "#,0;-#,0",
				    vMeasure = "Spread", "0.00%;-0.00%;0.00%"
				)
				RETURN 
				"""" & FORMAT(vValor, vFormat) & """"
				```

	measure Ops =
			
			COALESCE(
			    SUM(f_daily_sales[operations]),
			    SUM(f_gold_ops[operations]),
			    SUM(f_wallet[transactions])
			)
		formatString: #,0
		displayFolder: Operações
		lineageTag: ef04840a-b23c-411d-8ac5-926e8129af88

