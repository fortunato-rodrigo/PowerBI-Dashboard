	measure 'Big Number - AVG -3M (D0)' = ```
			
			VAR vValor = [# GAP AVG -3M (D0)] // Valor absoluto
			VAR vPercentual = [% GAP AVG -3M (D0)] // Valor em porcentagem
			VAR vMeasure = SELECTEDVALUE(Tabela[KPI])
			VAR vFormat = 
			    SWITCH(
			        TRUE(),
			        // Formatação para valores absolutos específicos
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor >= 1000000000, "+R$ #,#0,,,.00B;-R$ #,#0,,,.00B",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor >= 1000000, "+R$ #,#0,,.00M;-R$ #,#0,,.00M",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor >= 1000, "+R$ #,#0,.00K;-R$ #,#0,.00K",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor >= 0, "+R$ #,0;R$ #,0",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor <= -1000000000, "+R$ #,#0,,,.00B;-R$ #,#0,,,.00B",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor <= -1000000, "+R$ #,#0,,.00M;-R$ #,#0,,.00M",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor <= -1000, "+R$ #,#0,.00K;-R$ #,#0,.00K",
			        vMeasure in {"Receita", "GMV", "PNL"} && vValor < 0, "+R$ #,0.00;-R$ #,0.00",
			        vMeasure in {"Operações", "Presignups"} && vValor >= 1000000000, "+#,#0,,,.00B;-#,#0,,,.00B",
			        vMeasure in {"Operações", "Presignups"} && vValor >= 1000000, "+#,#0,,.00M;-#,#0,,.00M",
			        vMeasure in {"Operações", "Presignups"} && vValor >= 1000, "+#,#0,.00K;-#,#0,.00K",
			        vMeasure in {"Operações", "Presignups"} && vValor >= 0, "+#,0;-#,0",
			        vMeasure in {"Operações", "Presignups"} && vValor <= -1000000000, "+#,#0,,,.00B;-#,#0,,,.00B",
			        vMeasure in {"Operações", "Presignups"} && vValor <= -1000000, "+#,#0,,.00M;-#,#0,,.00M",
			        vMeasure in {"Operações", "Presignups"} && vValor <= -1000, "+#,#0,.00K;#,-#0,.00K",
			        vMeasure in {"Operações", "Presignups"} && vValor < 0, "+#,0;-#,0",
			        // Formatação específica para "Gap"
			        vMeasure in {"Gap"}, "+0.0%;-0.0%"
			    )
			VAR ValorFormatado = FORMAT(vValor, vFormat)
			VAR PercentualFormatado = FORMAT(vPercentual, "+0.0%;-0.0%")
			
			// Concatenando as medidas com formatação preservada
			RETURN 
			    ValorFormatado & " (" & PercentualFormatado & ")"
			```
		displayFolder: # Oficial\Big Number
		lineageTag: 759fae57-0695-4c7f-97a3-737e03c0d3f1

