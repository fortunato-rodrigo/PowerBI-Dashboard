	measure 'AVG -3M (MTD)' =
			
			// Calcula o final do último mês completo
			VAR LastMonthEnd = EOMONTH(MAX(f_gold_ops[operation_date]), -1)
			
			// Define o intervalo de 3 meses
			VAR StartDate = DATE(YEAR(EDATE(LastMonthEnd, -2)), MONTH(EDATE(LastMonthEnd, -2)), 1)
			VAR EndDate = LastMonthEnd
			
			RETURN
			CALCULATE(
			    AVERAGEX(
			        DATESBETWEEN(dcalendar[date_month], StartDate, EndDate),
			        [Realizado]
			    ),
			    ALL('dcalendar'),
			    'dcalendar'[mtd] = TRUE () // Considera apenas os dias do mês corrente
			)
		displayFolder: # Oficial\Realizado
		lineageTag: e239dd76-a4d0-43af-9de6-9fa9ac73ac4e

		formatStringDefinition = ```
				VAR vValor = SELECTEDMEASURE()
				VAR vMeasure = SELECTEDVALUE(Tabela[KPI])
				VAR vFormat = 
				SWITCH(
				    TRUE(),
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor >= 1000000000, "R$ #,#0,,,.00B;-R$ #,#0,,,.00B",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor >= 1000000, "R$ #,#0,,.00M;-R$ #,#0,,.00M",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor >= 1000, "R$ #,#0,.00K;-R$ #,#0,.00K",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor >= 0, "R$ #,0;R$ #,0",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor <= -1000000000, "R$ #,#0,,,.00B;R$ #,#0,,,.00B",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor <= -1000000, "R$ #,#0,,.00M;R$ #,#0,,.00M",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor <= -1000, "R$ #,#0,.00K;R$ #,#0,.00K",
				    vMeasure in {"Receita", "GMV", "Investimento", "PNL"} && vValor < 0, "R$ #,0.00;R$ #,0.00",
				    vMeasure in {"CPP", "CPA"}, "R$ #,0.00;R$ #,0.00",
				    vMeasure in {"Operações", "Presignups"} && vValor >= 1000000000, "#,#0,,,.00B;-#,#0,,,.00B",
				    vMeasure in {"Operações", "Presignups"} && vValor >= 1000000, "#,#0,,.00M;-#,#0,,.00M",
				    vMeasure in {"Operações", "Presignups"} && vValor >= 1000, "#,#0,.00K;-#,#0,.00K",
				    vMeasure in {"Operações", "Presignups"} && vValor >= 0, "#,0;-#,0"
				)
				RETURN 
				"""" & FORMAT(vValor, vFormat) & """"
