	measure 'Resumo Dashboard' = ```
			
			"<div style='display: flex; flex-wrap: wrap; gap: 15px; align-items: flex-start;'>
			
			    <!-- Bloco 1: Investimento -->
			    <div style='flex: 1; min-width: 350px; height: 160px; border: 1px solid #ddd; padding: 15px; background-color: #fff;'>
			        <h3>Investimento em Marketing</h3>
			        <div style='font-size: 20px;'>
			            - D-1: <b>"
			    & FORMAT( [Investimento (D-1)], "R$ #,##0" ) & "</b><br>
			            - Acumulado: <b>"
			    & FORMAT( [Investimento (MTD)], "R$ #,##0" ) & "</b>
			            (<b style='color:"
			    & IF( [Investimento % MOM (MTD)] >= 0, "#111111", "#111111" ) & ";'>"
			    & IF( [Investimento % MOM (MTD)] > 0, "+", "" )
			    & FORMAT( [Investimento % MOM (MTD)], "0.0%" ) & "</b> vs. " & [Mês Anterior] & ").<br><br>
			        </div>
			    </div>
			
			    <!-- Bloco 2: Presignups -->
			    <div style='flex: 1; min-width: 350px; height: 160px; border: 1px solid #ddd; padding: 15px; background-color: #fff;'>
			        <h3>Presignups (ex-FXaaS)</h3>
			        <div style='font-size: 20px;'>
			            - D-1: <b>"
			    & FORMAT( [Presignups (D-1)], "#,##0" ) & "</b> presignups.<br>
			            - Acumulado: <b>"
			    & FORMAT( [Presignups (MTD)], "#,##0" ) & "</b>
			            (<b style='color:"
			    & IF( [Presignups % MOM (MTD)] >= 0, "#1AAB40", "#D64554" ) & ";'>"
			    & IF( [Presignups % MOM (MTD)] > 0, "+", "" )
			    & FORMAT( [Presignups % MOM (MTD)], "0.0%" ) & "</b> vs. " & [Mês Anterior] & ").<br><br>
			        </div>
			    </div>
			
			    <!-- Bloco 3: CPP -->
			    <div style='flex: 1; min-width: 350px; height: 160px; border: 1px solid #ddd; padding: 15px; background-color: #fff;'>
			        <h3>Custo por Presignup (CPP)</h3>
			        <div style='font-size: 20px;'>
			            - D-1: <b>"
			    & FORMAT( [CPP (D-1)], "R$ #,##0.00" ) & "</b><br>
			            - Acumulado: <b>"
			    & FORMAT( [CPP (MTD)], "R$ #,##0.00" ) & "</b>
			            (<b style='color:"
			    & IF( [CPP # MOM (MTD)] >= 0, "#D64554", "#1AAB40" ) & ";'>"
			    & IF( [CPP # MOM (MTD)] > 0, "+", "" )
			    & FORMAT( [CPP # MOM (MTD)], "R$ #,##0.00" ) & "</b> vs. " & [Mês Anterior] & ").<br><br>
			        </div>
			    </div>
			
			    <!-- Bloco 4: Aquisições -->
			    <div style='flex: 1; min-width: 350px; height: 160px; border: 1px solid #ddd; padding: 15px; background-color: #fff;'>
			        <h3>Aquisições</h3>
			        <div style='font-size: 20px;'>
			            - D-1: <b>"
			    & FORMAT( [Aquisições (D-1)], "#,##0" ) & "</b> aquisições 
			            (<b style='color:"
			    & IF( [% Gap de Aquisições (D-1)] >= 1, "#1AAB40", "#D64554" ) & ";'>"
			    & FORMAT( [% Gap de Aquisições (D-1)], "0.0%" ) & "</b> da meta diária).<br>
			            - Acumulado: <b>"
			    & FORMAT( [Aquisições (MTD)], "#,##0" ) & "</b> 
			            (<b style='color:"
			    & IF( [% Gap de Aquisições (MTD)] >= 1, "#1AAB40", "#D64554" ) & ";'>"
			    & FORMAT( [% Gap de Aquisições (MTD)], "0.0%" ) & "</b> da meta MTD).<br><br>
			        </div>
			    </div>
			
			    <!-- Bloco 5: CPA -->
			    <div style='flex: 1; min-width: 350px; height: 160px; border: 1px solid #ddd; padding: 15px; background-color: #fff;'>
			        <h3>Custo por Aquisição (CPA)</h3>
			        <div style='font-size: 20px;'>
			            - D-1: <b>"
			    & FORMAT( [CPA (D-1)], "R$ #,##0.00" ) & "</b><br>
			            - Acumulado: <b>"
			    & FORMAT( [CPA (MTD)], "R$ #,##0.00" ) & "</b>
			            (<b style='color:"
			    & IF( [CPA # MOM (MTD)] >= 0, "#D64554", "#1AAB40" ) & ";'>"
			    & IF( [CPA # MOM (MTD)] > 0, "+", "" )
			    & FORMAT( [CPA # MOM (MTD)], "R$ #,##0.00" ) & "</b> vs. " & [Mês Anterior] & ").<br><br>
			        </div>
			    </div>
			
			    <!-- Bloco 6: Receita Bruta -->
			    <div style='flex: 1; min-width: 350px; height: 160px; border: 1px solid #ddd; padding: 15px; background-color: #fff;'>
			        <h3>Receita Bruta</h3>
			        <div style='font-size: 20px;'>
			            - D-1: <b>"
			    & FORMAT( [Receita (D-1)], "R$ #,##0" ) & "</b> 
			            (<b style='color:"
			    & IF( [% Gap de Receita (D-1)] >= 1, "#1AAB40", "#D64554" ) & ";'>"
			    & FORMAT( [% Gap de Receita (D-1)], "0.0%" ) & "</b> da meta diária).<br>
			            - Acumulado: <b>"
			    & FORMAT( [Receita (MTD)], "R$ #,##0" ) & "</b>
			            (<b style='color:"
			    & IF( [% Gap de Receita (MTD)] >= 1, "#1AAB40", "#D64554" ) & ";'>"
			    & FORMAT( [% Gap de Receita (MTD)], "0.0%" ) & "</b> da meta MTD).<br><br>
			        </div>
			    </div>
			
			</div>"
			```
		displayFolder: # Oficial\HMTL
		lineageTag: b0a29b93-e8a8-4d37-93e7-6f86e783c279

