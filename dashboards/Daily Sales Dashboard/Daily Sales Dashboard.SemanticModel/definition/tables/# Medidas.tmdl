	measure 'Realizado (D0)' =
			
			CALCULATE(
			    [Realizado],
			    dcalendar[is_current_date] = TRUE()
			)
		displayFolder: # Oficial\Realizado
		lineageTag: bc2bc499-9e83-4b87-9eff-0a7a40c39594

		formatStringDefinition = ```
				VAR vValor = SELECTEDMEASURE()
				VAR vMeasure = SELECTEDVALUE(Tabela[KPI])
				VAR vFormat = 
				SWITCH(
				    TRUE(),
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 1000000000, "R$ #,#0,,,.00B;-R$ #,#0,,,.00B",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 1000000, "R$ #,#0,,.00M;-R$ #,#0,,.00M",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 1000, "R$ #,#0,.00K;-R$ #,#0,.00K",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor >= 0, "R$ #,0;R$ #,0",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor <= -1000000000, "R$ #,#0,,,.00B;R$ #,#0,,,.00B",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor <= -1000000, "R$ #,#0,,.00M;R$ #,#0,,.00M",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor <= -1000, "R$ #,#0,.00K;R$ #,#0,.00K",
				    vMeasure in {"Receita", "GMV", "Ticket Médio", "Investimento", "PNL", "Custo de Mensageria", "Take do Banco"} && vValor < 0, "R$ #,0.00;R$ #,0.00",
				    vMeasure in {"CPP", "CPA"}, "R$ #,0.00;R$ #,0.00",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 1000000000, "#,#0,,,.00B;-#,#0,,,.00B",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 1000000, "#,#0,,.00M;-#,#0,,.00M",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 1000, "#,#0,.00K;-#,#0,.00K",
				    vMeasure in {"Operações", "DAUs", "Presignups"} && vValor >= 0, "#,0;-#,0",
				    vMeasure = "Spread", "0.00%;-0.00%;0.00%"
				)
				RETURN 
				"""" & FORMAT(vValor, vFormat) & """"
				```

