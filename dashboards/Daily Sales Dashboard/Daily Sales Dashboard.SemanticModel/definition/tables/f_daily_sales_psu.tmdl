	partition f_daily_sales_psu = m
		mode: import
		queryGroup: Principais
		source =
				let
				    Fonte = Value.NativeQuery(Databricks.Catalogs("beetech-prod-analytics.cloud.databricks.com", "/sql/1.0/endpoints/e35e97a9319a6fe7", [Catalog="prod", Database=null, EnableAutomaticProxyDiscovery=null]){[Name="prod",Kind="Database"]}[Data], "WITH lc AS (#(lf)  SELECT #(lf)    DATE(dc.psu_date) AS date_key,#(lf)    lc.canal,#(lf)    dc.customer_type,#(lf)    COUNT(lc.id_customer) AS realizado_psu#(lf)  FROM google_analytics.last_click_sessions AS lc#(lf)  LEFT JOIN bronze.beecambio_customer AS dc #(lf)    ON lc.id_customer = dc.id#(lf)  WHERE DATE(lc.event_date) >= '2024-01-01'#(lf)  AND dc.email not like '%fxaas%'#(lf)  GROUP BY ALL#(lf)), final as (#(lf)SELECT #(lf)  COALESCE(ds.date_key, lc.date_key) AS date_key,#(lf)  COALESCE(ds.event_type, 'PRESIGNUP') AS event_type,#(lf)  COALESCE(ds.channel, lc.canal) AS canal,#(lf)  COALESCE(ds.customer_type, lc.customer_type) AS customer_type,#(lf)  SUM(ds.goal_psu) as goal_psu,#(lf)  COALESCE(COALESCE(SUM(lc.realizado_psu), 0), COALESCE(SUM(ds.realizado_psu), 0)) AS realizado_psu#(lf)FROM gold.daily_sales_psu AS ds#(lf)FULL OUTER JOIN lc #(lf)  ON lc.date_key = ds.date_key #(lf)  AND lc.canal = ds.channel#(lf)  AND lc.customer_type = ds.customer_type#(lf)GROUP BY ALL#(lf))#(lf)#(lf)select * from final", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

