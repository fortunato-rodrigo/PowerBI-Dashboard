                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "O ",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  },
                  {
                    "value": "Prophet ",
                    "textStyle": {
                      "fontStyle": "italic",
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  },
                  {
                    "value": "ajuda a prever dados futuros baseados em dados passados;",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Ele considera padrões que se repetem (sazonalidade), feriados e tendências gerais.",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O que é o Prophet?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt",
                      "color": "#893395"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prophet é uma ferramenta que ajuda a prever o futuro com base em padrões históricos.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "É eficaz para dados com padrões repetitivos, como vendas mensais.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Prophet é fácil de usar e lida bem com dados faltantes ou mudanças inesperadas.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Exemplo:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontStyle": "italic",
                      "fontSize": "18pt",
                      "color": "#893395"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Imagine que queremos prever as vendas futuras de sorvete em uma sorveteria. Se tivermos dados de vendas diárias dos últimos anos, o Prophet pode usar esses dados para prever quantos sorvetes venderemos nos próximos meses. Ele vai considerar coisas como:",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Vendas maiores no verão (sazonalidade).",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Menos vendas em dias chuvosos (mudanças).",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Feriados que podem aumentar ou diminuir as vendas.",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Etapa 2: Projeção de GMV e Receita",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "18pt",
                      "color": "#893395"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Para esses números, usamos uma abordagem mais precisa.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Calculamos a média dos últimos 90 dias, excluindo valores extremos (outliers) que possam inflar a projeção.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Consideramos apenas as operações dentro do percentil 0.99, agrupadas por bu, business_type e customer_type, o que torna a projeção mais realista.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Distribuímos esse valor ao longo dos dias, baseado na projeção de operações da Etapa 1.",
                    "textStyle": {
                      "fontSize": "18pt"
                    }
                  }
                ],
                "listType": "bullet"
