                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Usamos uma ferramenta chamada ",
                    "textStyle": {
                      "fontSize": "18pt",
                      "color": "#333333"
                    }
                  },
                  {
                    "value": "Prophet",
                    "textStyle": {
