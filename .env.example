# NUNCA commite o arquivo .env — ele esta no .gitignore
# Copie para .env e preencha os valores. Use .\tools\Setup-Env.ps1 para preencher
# automaticamente as credenciais Power BI a partir do AWS SSM Parameter Store.

# --- Power BI (service principal) ---
# Valores em: AWS SSM Parameter Store > /prod/data/variables/PBI_*
POWERBI_AUTH_MODE=service_principal
POWERBI_TENANT_ID=seu-tenant-id-aqui
POWERBI_CLIENT_ID=seu-client-id-aqui
POWERBI_CLIENT_SECRET=seu-client-secret-aqui


# --- Databricks ---
# Host e Warehouse ID nao sao segredos (visiveis nos arquivos .tmdl)
DATABRICKS_HOST=beetech-prod-analytics.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=e35e97a9319a6fe7

# Token pessoal (PAT) — usado por todos os scripts deste repo:
#   1. Acesse https://beetech-prod-analytics.cloud.databricks.com
#   2. Canto superior direito > Settings > Developer > Access tokens
#   3. Generate new token > copie o valor abaixo
DATABRICKS_TOKEN=seu-databricks-personal-token-aqui
